<UserControl x:Class="SkVP.Views.TykaSaPole"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- „Týka sa“: čipy predmetov, oblastí a častí osnov (DataContext = TykaSaVM) -->
    <StackPanel>
        <ItemsControl ItemsSource="{Binding Polozky}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="10" Padding="9,2,3,3" Margin="0,0,5,5" ToolTip="{Binding Tip}"
                            Background="{Binding Farba, Converter={StaticResource FarbaNaStetec}, ConverterParameter=38}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RiadokTlacidlo}" Padding="0" Cursor="Hand" ToolTip="Otvoriť"
                                    Command="{Binding DataContext.OtvoritCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="{Binding Text}" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="240"
                                           Foreground="{Binding Farba, Converter={StaticResource FarbaNaStetec}, ConverterParameter=T}" />
                            </Button>
                            <Button Style="{StaticResource IkonoveTlacidlo}" Width="20" Height="20" FontSize="9" Margin="4,0,0,0"
                                    Content="&#xE711;" ToolTip="Odobrať"
                                    Command="{Binding DataContext.OdobratCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal">
            <Button Padding="10,3" Command="{Binding VybratCommand}" ToolTip="Vybrať predmety, oblasti alebo časti osnov">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Ikona}" Text="&#xE71B;" FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="Vybrať…" FontSize="12.5" />
                </StackPanel>
            </Button>
            <TextBlock Text="nič – všeobecné" Style="{StaticResource Popis}" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding JePrazdne, Converter={StaticResource BoolNaViditelnost}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
