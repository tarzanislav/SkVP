<Window x:Class="SkVP.Views.VyberSkupinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" MaxHeight="720" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="24,18,24,18">
        <TextBlock x:Name="Nadpis" DockPanel.Dock="Top" Style="{StaticResource Podnadpis}" FontSize="18" />
        <TextBlock x:Name="Popis" DockPanel.Dock="Top" Style="{StaticResource Popis}" TextWrapping="Wrap" Margin="0,0,0,10" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Všetko" Padding="10,3" Click="Vsetko_Click" />
                <Button Content="Nič" Padding="10,3" Margin="6,0,0,0" Click="Nic_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="Ok" MinWidth="120" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Click="Ok_Click" />
                <Button Content="Zrušiť" MinWidth="100" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Zoznam" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding Vybrana}" Margin="0,3">
                            <TextBlock Text="{Binding Nazov}" TextWrapping="Wrap" />
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
