<Window x:Class="SkVP.Views.VymazanieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vymazať údaje" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="28,24,28,24">
        <TextBlock Text="Vymazať údaje a začať s reálnymi osnovami" Style="{StaticResource Podnadpis}" FontSize="19" />
        <TextBlock Style="{StaticResource Popis}" FontSize="13" Margin="0,0,0,16"
                   Text="Vyberte, čo sa má vymazať. Pred vymazaním sa automaticky vytvorí záloha, z ktorej sa dá všetko obnoviť." />

        <RadioButton x:Name="LenOsnovy" GroupName="Rozsah" IsChecked="True" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Vymazať osnovy, oblasti a predmety ponechať" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Popis}" Text="Vymažú sa texty osnov, charakteristiky oblastí, archív verzií, súvislosti a údaje vymyslenej školy z testovacej sady (názov, logo, texty úvodnej strany). Štruktúra oblastí a predmetov zostane – vhodné, keď idete vkladať reálne osnovy." />
            </StackPanel>
        </RadioButton>
        <RadioButton x:Name="Vsetko" GroupName="Rozsah">
            <StackPanel>
                <TextBlock Text="Vymazať všetko vrátane oblastí a predmetov" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Popis}" Text="Program bude prázdny a znova sa opýta, s čím chcete začať. Údaje vymyslenej školy z testovacej sady sa vymažú; vaša vlastná škola, logo a vzhľad zostanú." />
            </StackPanel>
        </RadioButton>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Vymazať" MinWidth="120" Style="{DynamicResource AccentButtonStyle}" Click="Vymazat_Click" />
            <Button Content="Zrušiť" MinWidth="100" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
