<Window x:Class="SkVP.Views.ExportOsnovWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:SkVP.Views"
        xmlns:vm="clr-namespace:SkVP.ViewModels"
        Title="Export učebných osnov" Width="900" Height="700" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="20,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Padding="18,6" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Command="{Binding ExportovatCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xEDE1;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Exportovať…" />
                        </StackPanel>
                    </Button>
                    <Button Content="Zavrieť" Padding="16,6" Margin="8,0,0,0" IsCancel="True" />
                </StackPanel>
                <TextBlock Text="{Binding Stav}" Style="{StaticResource Popis}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <Grid Margin="24,18,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- čo sa exportuje -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Ktoré osnovy" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <RadioButton Content="Všetky vzdelávacie oblasti a predmety" GroupName="Rozsah"
                                 IsChecked="{Binding Len, Converter={StaticResource InverzBool}}" />
                    <RadioButton Content="Len vybrané oblasti a predmety" GroupName="Rozsah" IsChecked="{Binding Len}" Margin="0,2,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding Len, Converter={StaticResource BoolNaViditelnost}}">
                        <Button Content="Vybrať všetko" Padding="10,3" Command="{Binding VybratVsetkoCommand}" />
                        <Button Content="Zrušiť výber" Padding="10,3" Margin="6,0,0,0" Command="{Binding ZrusitVyberCommand}" />
                    </StackPanel>
                </StackPanel>
                <Border Style="{StaticResource Karta}" Padding="8" IsEnabled="{Binding Len}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Oblasti}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:VolbaOblastiExportu}">
                                    <Expander Margin="0,0,0,2" Padding="0">
                                        <Expander.Header>
                                            <CheckBox IsChecked="{Binding Zahrnut}" IsThreeState="False">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="10" Height="10" CornerRadius="2.5" Margin="0,0,8,0" VerticalAlignment="Center"
                                                            Background="{Binding Oblast.Farba, Converter={StaticResource FarbaNaStetec}}" />
                                                    <TextBlock Text="{Binding Oblast.Nazov}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </CheckBox>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Predmety}" Margin="30,0,0,6" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:VolbaPredmetuExportu}">
                                                    <CheckBox IsChecked="{Binding Zahrnut}" Margin="0,1">
                                                        <TextBlock>
                                                            <Run Text="{Binding Predmet.Cislo, Mode=OneWay}" Foreground="{Binding Predmet.Oblast.Farba, Converter={StaticResource FarbaNaStetec}, ConverterParameter=T}" />
                                                            <Run Text="  " /><Run Text="{Binding Predmet.Nazov, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <!-- ako -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Formát" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Formaty}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding Format}" />
                    <Button Content="Nastavenia PDF…" HorizontalAlignment="Left" Padding="10,4" Margin="0,8,0,0" Command="{Binding NastaveniaPdfCommand}"
                            Visibility="{Binding JePdf, Converter={StaticResource BoolNaViditelnost}}"
                            ToolTip="Šifrovanie, heslo, zákazy, sivá, zosvetlenie, 2 – 8 strán na list, brožúra" />

                    <TextBlock Text="Súbory" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <RadioButton Content="Jeden dokument so všetkými osnovami" GroupName="Subory"
                                 IsChecked="{Binding Jednotlivo, Converter={StaticResource InverzBool}}" />
                    <RadioButton GroupName="Subory" IsChecked="{Binding Jednotlivo}" Margin="0,4,0,0">
                        <TextBlock TextWrapping="Wrap" Text="Každý predmet zvlášť – „05 Fyzika 2026“ v priečinku oblasti" />
                    </RadioButton>

                    <StackPanel Visibility="{Binding JedenDokument, Converter={StaticResource BoolNaViditelnost}}">
                        <TextBlock Text="Obsah dokumentu" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <CheckBox Content="Úvodná strana (škola, logo, nadpis)" IsChecked="{Binding TitulnaStrana}" />
                        <CheckBox Content="Obsah s číslami strán" IsChecked="{Binding Obsah}" Margin="0,4,0,0" />
                        <CheckBox Content="Oddeľujúca strana pred oblasťou" IsChecked="{Binding OddelovacOblasti}" Margin="0,4,0,0" />
                        <CheckBox Content="Oddeľujúca strana pred predmetom" IsChecked="{Binding OddelovacPredmetu}" Margin="0,4,0,0" />
                        <CheckBox Content="Charakteristiky vzdelávacích oblastí" IsChecked="{Binding Charakteristiky}" Margin="0,4,0,0" />
                        <Expander Margin="0,10,0,0" Header="Údaje o škole v zostave">
                            <v:UdajeOSkoleVZostave DataContext="{Binding UdajeOSkole}" Margin="4,6,0,4" />
                        </Expander>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding Nespracovane}" Margin="0,8,0,0">
                        <TextBlock TextWrapping="Wrap" Text="Aj predmety, ktorých osnova ešte nemá text" />
                    </CheckBox>
                    <TextBlock Style="{StaticResource Popis}" Margin="0,16,0,0" TextWrapping="Wrap"
                               Text="Texty úvodnej strany a hlavičky upravíte v Tlač a zostavy → Upraviť úvodnú stranu, logo a hlavičku. Údaje o škole v zostave sú spoločné s tlačou. Pri exporte každého predmetu zvlášť sa ukladajú samotné osnovy (bez úvodnej strany)." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
