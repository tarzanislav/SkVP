<Window x:Class="SkVP.Views.PrveSpustenieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:SkVP.Views"
        Title="Vitajte v programe SkVP" Icon="pack://application:,,,/Assets/skvp.ico"
        Width="800" Height="780" MinHeight="620" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- voľba ako karta -->
        <Style x:Key="Volba" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Zaciatok" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Ram" CornerRadius="10" BorderThickness="1.5" Padding="18,14"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <DockPanel>
                                <Border x:Name="Kruh" DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" Margin="0,2,14,0"
                                        VerticalAlignment="Top" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
                                    <Ellipse x:Name="Bod" Width="8" Height="8" Fill="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden" />
                                </Border>
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ram" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ram" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Kruh" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Bod" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- farebné záložky oblastí ako v šanóne -->
        <UniformGrid DockPanel.Dock="Top" Rows="1" Height="8">
            <Border Background="{Binding Source='#3B5BDB', Converter={StaticResource FarbaNaStetec}}" />
            <Border Background="{Binding Source='#0C8599', Converter={StaticResource FarbaNaStetec}}" />
            <Border Background="{Binding Source='#2F9E44', Converter={StaticResource FarbaNaStetec}}" />
            <Border Background="{Binding Source='#E67700', Converter={StaticResource FarbaNaStetec}}" />
            <Border Background="{Binding Source='#C2255C', Converter={StaticResource FarbaNaStetec}}" />
            <Border Background="{Binding Source='#7048E8', Converter={StaticResource FarbaNaStetec}}" />
            <Border Background="{Binding Source='#D9480F', Converter={StaticResource FarbaNaStetec}}" />
        </UniformGrid>

        <DockPanel DockPanel.Dock="Bottom" Margin="40,0,40,24">
            <TextBlock x:Name="Krok" DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Popis}" Text="Krok 1 z 2" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="Spat" Content="Späť" MinWidth="110" Padding="16,8" Margin="0,0,8,0" Click="Spat_Click" Visibility="Collapsed" />
                <Button x:Name="Dalej" Content="Ďalej" MinWidth="150" Padding="16,8" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Click="Dalej_Click" />
            </StackPanel>
        </DockPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="40,26,40,0">
            <Image Source="pack://application:,,,/Assets/skvp.ico" Width="52" Height="52" />
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Vitajte v programe SkVP" Style="{StaticResource Nadpis}" FontSize="28" />
                <TextBlock Text="Evidencia, spracovanie a archivácia školského vzdelávacieho programu" Style="{StaticResource Popis}" FontSize="13.5" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="40,18,40,10">
                <!-- krok 1: údaje o organizácii -->
                <StackPanel x:Name="Krok1">
                    <TextBlock Text="Údaje o škole" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Style="{StaticResource Popis}" TextWrapping="Wrap" Margin="0,2,0,6"
                               Text="Vyplňte základné údaje o škole – tlačia sa na úvodnej strane učebných osnov, v hlavičke a päte strán. Neskôr ich zmeníte v Nastaveniach (Údaje o organizácii)." />
                    <v:UdajeOrganizacieEditor x:Name="Organizacia" />
                    <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Content="Vybrať logo…" Padding="12,5" Click="Logo_Click" />
                        <TextBlock x:Name="StavLoga" VerticalAlignment="Center" Text="Logo školy (nepovinné) – obrázok PNG, JPG alebo SVG." Style="{StaticResource Popis}" />
                    </DockPanel>
                </StackPanel>

                <!-- krok 2: s čím začať -->
                <StackPanel x:Name="Krok2" Visibility="Collapsed">
                    <TextBlock Text="S čím chcete začať?" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                    <RadioButton x:Name="VolbaSvp" Style="{StaticResource Volba}" IsChecked="True">
                        <StackPanel>
                            <TextBlock Text="Vzdelávacie oblasti podľa Štátneho vzdelávacieho programu pre gymnáziá" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Popis}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="7 vzdelávacích oblastí s oficiálnymi charakteristikami zo ŠVP (ŠPÚ). Predmety sa vytvoria z vašich učebných osnov – program ich načíta z priečinka (Word alebo PDF) a predmet rozpozná podľa názvu v úvodnej tabuľke dokumentu." />
                            <DockPanel Margin="0,10,0,0" IsEnabled="{Binding IsChecked, ElementName=VolbaSvp}">
                                <Button DockPanel.Dock="Right" Content="Vybrať priečinok…" Padding="12,4" Margin="8,0,0,0" Click="Priecinok_Click" />
                                <TextBlock x:Name="Priecinok" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5"
                                           Text="Priečinok s učebnými osnovami: nevybraný (osnovy môžete naimportovať aj neskôr v sekcii Import a export)" />
                            </DockPanel>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="VolbaTestovacia" Style="{StaticResource Volba}">
                        <StackPanel>
                            <TextBlock Text="Testovacia sada na vyskúšanie programu" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Style="{StaticResource Popis}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="Učebný plán gymnázia s ukážkovými osnovami všetkých predmetov, charakteristiky oblastí zo ŠVP a vymyslená škola – dá sa neskôr vymazať bez zvyškov (Servis)." />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="VolbaGymnazium" Style="{StaticResource Volba}">
                        <StackPanel>
                            <TextBlock Text="Učebný plán gymnázia bez osnov" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock x:Name="PopisGymnazia" Style="{StaticResource Popis}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="VolbaExcel" Style="{StaticResource Volba}">
                        <StackPanel>
                            <TextBlock Text="Načítať z tabuľky Excel" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Style="{StaticResource Popis}" FontSize="12.5" Margin="0,2,0,0"
                                       Text="Vlastná tabuľka: názov oblasti v stĺpci A, predmety pod ním v stĺpci B." />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="VolbaPrazdny" Style="{StaticResource Volba}">
                        <StackPanel>
                            <TextBlock Text="Začať bez oblastí" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Style="{StaticResource Popis}" FontSize="12.5" Margin="0,2,0,0"
                                       Text="Oblasti a predmety pridáte sami v sekcii Osnovy alebo importom (Import a export)." />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
