<Window x:Class="SkVP.Views.PrveSpustenieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vitajte v programe SkVP" Icon="pack://application:,,,/Assets/skvp.ico"
        Width="760" Height="680" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- voľba ako karta -->
        <Style x:Key="Volba" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Zaciatok" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Ram" CornerRadius="10" BorderThickness="1.5" Padding="18,14"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <DockPanel>
                                <Border x:Name="Kruh" DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" Margin="0,2,14,0"
                                        VerticalAlignment="Top" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
                                    <Ellipse x:Name="Bod" Width="8" Height="8" Fill="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden" />
                                </Border>
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ram" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ram" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Kruh" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Bod" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- farebné záložky oblastí ako v šanóne -->
        <UniformGrid DockPanel.Dock="Top" Rows="1" Height="8">
            <Border Background="#3B5BDB" />
            <Border Background="#0C8599" />
            <Border Background="#2F9E44" />
            <Border Background="#E67700" />
            <Border Background="#C2255C" />
            <Border Background="#7048E8" />
            <Border Background="#D9480F" />
        </UniformGrid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="40,0,40,28">
            <Button Content="Začať" MinWidth="150" Padding="16,8" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Click="Zacat_Click" />
        </StackPanel>

        <StackPanel Margin="40,30,40,10">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/skvp.ico" Width="52" Height="52" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Vitajte v programe SkVP" Style="{StaticResource Nadpis}" FontSize="28" />
                    <TextBlock Text="Evidencia, spracovanie a archivácia školského vzdelávacieho programu" Style="{StaticResource Popis}" FontSize="13.5" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Názov školy" Style="{StaticResource Stitok}" Margin="0,26,0,4" />
            <TextBox x:Name="Skola" FontSize="14" />

            <TextBlock Text="S čím chcete začať?" FontWeight="SemiBold" FontSize="14" Margin="0,22,0,10" />
            <RadioButton x:Name="VolbaGymnazium" Style="{StaticResource Volba}" IsChecked="True">
                <StackPanel>
                    <TextBlock Text="Učebný plán gymnázia" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock x:Name="PopisGymnazia" Style="{StaticResource Popis}" FontSize="12.5" Margin="0,2,0,0" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="VolbaExcel" Style="{StaticResource Volba}">
                <StackPanel>
                    <TextBlock Text="Načítať z tabuľky Excel" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Style="{StaticResource Popis}" FontSize="12.5" Margin="0,2,0,0"
                               Text="Vlastná tabuľka: názov oblasti v stĺpci A, predmety pod ním v stĺpci B." />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="VolbaPrazdny" Style="{StaticResource Volba}">
                <StackPanel>
                    <TextBlock Text="Začať bez oblastí" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Style="{StaticResource Popis}" FontSize="12.5" Margin="0,2,0,0"
                               Text="Oblasti a predmety pridáte sami v sekcii Osnovy." />
                </StackPanel>
            </RadioButton>
        </StackPanel>
    </DockPanel>
</Window>
