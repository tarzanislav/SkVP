<UserControl x:Class="SkVP.Views.ServisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44,34,44,40" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="Servis" Style="{StaticResource Nadpis}" />
            <TextBlock Text="Zálohy učebných osnov (Word a PDF) a všetkých dát, archív osnov za školský rok, obnova, kontrola, údržba a oprava databázy." Style="{StaticResource Popis}" FontSize="14" Margin="0,4,0,20" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- zálohy -->
                <Border Style="{StaticResource Karta}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE8C8;" FontSize="20" Margin="0,0,10,0" />
                            <TextBlock Text="Zálohy" Style="{StaticResource Podnadpis}" Margin="0" />
                        </StackPanel>
                        <TextBlock Text="{Binding StavZaloh}" TextWrapping="WrapWithOverflow" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Padding="14,6" Margin="0,0,8,6" Style="{DynamicResource AccentButtonStyle}" Command="{Binding ZalohovatVsetkoCommand}"
                                    ToolTip="Celá databáza – oblasti, predmety, osnovy, archív verzií, nastavenia a logo (ZIP)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Ikona}" Text="&#xE8C8;" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Zálohovať všetky dáta" />
                                </StackPanel>
                            </Button>
                            <Button Padding="14,6" Margin="0,0,8,6" Command="{Binding ZalohovatOsnovyCommand}"
                                    ToolTip="Všetky osnovy a ich archív v priečinkoch oblastí (ZIP) – každý dokument vo Worde a vedľa neho v PDF; otvoria sa aj bez programu">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Ikona}" Text="&#xE8A5;" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Zálohovať učebné osnovy (Word, PDF)" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                            <Button Padding="12,6" Margin="0,0,8,6" Content="Otvoriť priečinok záloh" Command="{Binding OtvoritZalohyCommand}" />
                        </WrapPanel>

                        <TextBlock Text="Pravidelná záloha (pri spustení programu)" Style="{StaticResource Stitok}" />
                        <WrapPanel>
                            <RadioButton Content="Denne" GroupName="Frekvencia" Margin="0,0,18,0"
                                         IsChecked="{Binding Frekvencia, Converter={StaticResource RovnaSa}, ConverterParameter=denne}" />
                            <RadioButton Content="Týždenne" GroupName="Frekvencia" Margin="0,0,18,0"
                                         IsChecked="{Binding Frekvencia, Converter={StaticResource RovnaSa}, ConverterParameter=tyzdenne}" />
                            <RadioButton Content="Vypnutá" GroupName="Frekvencia"
                                         IsChecked="{Binding Frekvencia, Converter={StaticResource RovnaSa}, ConverterParameter=vypnute}" />
                        </WrapPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <TextBlock Text="Ponechať posledných" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding Ponechat, UpdateSourceTrigger=PropertyChanged}" Width="64" />
                            <TextBlock Text="automatických záloh" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </WrapPanel>
                        <TextBlock Text="Priečinok na zálohy (aj USB kľúč, sieťový disk, OneDrive)" Style="{StaticResource Stitok}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PriecinokZaloh}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Zmeniť…" Padding="12,4" Command="{Binding VybratPriecinokZalohCommand}" />
                            <Button Content="Predvolený" Padding="12,4" Margin="6,0,0,0" Command="{Binding PredvolenyPriecinokZalohCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- obnova -->
                <Border Grid.Column="2" Style="{StaticResource Karta}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE777;" FontSize="20" Margin="0,0,10,0" />
                            <TextBlock Text="Obnova zo zálohy" Style="{StaticResource Podnadpis}" Margin="0" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Nahradí súčasné dáta dátami zo zálohy. Program pred obnovou skontroluje, či záloha nie je poškodená, a súčasný stav ešte zálohuje. Takto sa dajú preniesť dáta aj na nový počítač." />
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Button Content="Obnoviť vybranú zálohu…" Padding="12,5" Margin="0,0,8,6" Command="{Binding ObnovitVybranuCommand}" />
                            <Button Content="Obnoviť zo súboru…" Padding="12,5" Margin="0,0,8,6" Command="{Binding ObnovitZoSuboruCommand}" />
                        </WrapPanel>
                        <ListBox ItemsSource="{Binding Zalohy}" SelectedItem="{Binding Vybrana}" Height="230" BorderThickness="1"
                                 BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,2">
                                        <TextBlock Text="{Binding Nazov}" FontSize="12.5" />
                                        <TextBlock Text="{Binding Popis}" Style="{StaticResource Popis}" FontSize="11.5" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- archív školského roka -->
            <Border Style="{StaticResource Karta}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Ikona}" Text="&#xE7B8;" FontSize="20" Margin="0,0,10,0" />
                        <TextBlock Text="Archív osnov za školský rok" Style="{StaticResource Podnadpis}" Margin="0" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap"
                               Text="Celé učebné osnovy tak, ako platili v školskom roku – do sekcie Archív (prehľad so štatistikami roka), do archívu verzií v programe a do priečinka Dokumenty\SkVP\Archív školských rokov: osnovy vo Worde po oblastiach a celé osnovy v jednom dokumente Word a v archívnom PDF/A. Odporúčame na konci každého školského roka." />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Školský rok" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox ItemsSource="{Binding SkolskeRoky}" SelectedItem="{Binding SkolskyRok}" Width="130" />
                        <Button Padding="14,6" Margin="12,0,0,0" Style="{DynamicResource AccentButtonStyle}" Command="{Binding ArchivovatRokCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Ikona}" Text="&#xE7B8;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Archivovať osnovy školského roka…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding ArchivyRokov}" Margin="0,12,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Content="Priečinok" Padding="10,3" Margin="6,0,0,0"
                                            Command="{Binding DataContext.OtvoritArchivRokaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button DockPanel.Dock="Right" Content="Prezerať v Archíve" Padding="10,3"
                                            Command="{Binding DataContext.PrezeratArchivRokaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding SkolskyRok, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="  •  " /><Run Text="{Binding Vytvorene, Mode=OneWay, StringFormat={}{0:d. M. yyyy H:mm}}" />
                                        <Run Text="  •  predmetov: " /><Run Text="{Binding Predmetov, Mode=OneWay}" /><Run Text="  •  dokumentov: " /><Run Text="{Binding Dokumentov, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- databáza: informácie, kontrola, údržba, oprava (ako v EviTA) -->
            <Border Style="{StaticResource Karta}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Ikona}" Text="&#xE9F9;" FontSize="20" Margin="0,0,10,0" />
                        <TextBlock Text="Databáza" Style="{StaticResource Podnadpis}" Margin="0" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap"><Run Text="Umiestnenie: " /><Run Text="{Binding CestaDatabazy, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="Veľkosť: " /><Run Text="{Binding Velkost, Mode=OneWay}" /><Run Text="   •   verzia dátovej štruktúry: " /><Run Text="{Binding VerziaSchemy, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Pocty}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource Popis}">
                        <Run Text="Posledná kontrola: " /><Run Text="{Binding PoslednaKontrola, Mode=OneWay}" />
                    </TextBlock>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Kontrola" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                            <Button Padding="12,5" Margin="0,0,0,6" HorizontalContentAlignment="Left" Command="{Binding RychlaKontrolaCommand}"
                                    Content="Rýchla kontrola" ToolTip="Overí, že súbor databázy nie je poškodený (niekoľko sekúnd). Robí sa aj pri každom spustení programu." />
                            <Button Padding="12,5" Margin="0,0,0,6" HorizontalContentAlignment="Left" Command="{Binding UplnaKontrolaCommand}"
                                    Content="Úplná kontrola integrity" ToolTip="Dôkladne prejde celú databázu. Odporúča sa raz za mesiac." />
                            <Button Padding="12,5" Margin="0,0,0,6" HorizontalContentAlignment="Left" Command="{Binding KontrolaVaziebCommand}"
                                    Content="Kontrola väzieb" ToolTip="Predmety bez oblasti, osnovy a verzie bez predmetu, súvislosti na zmazané predmety." />
                            <Button Padding="12,5" Margin="0,0,0,6" HorizontalContentAlignment="Left" Command="{Binding KontrolaDatCommand}"
                                    Content="Kontrola dát" ToolTip="Osnovy, ktoré sa nedajú otvoriť, kontrolné súčty, duplicitné predmety, predmety bez osnovy." />

                            <TextBlock Text="Údržba" Style="{StaticResource Stitok}" Margin="0,10,0,4" />
                            <Button Padding="12,5" Margin="0,0,0,6" HorizontalContentAlignment="Left" Command="{Binding OptimalizovatCommand}"
                                    Content="Optimalizovať" ToolTip="Aktualizuje štatistiky databázy pre rýchle vyhľadávanie. Robí sa aj pri zatvorení programu." />
                            <Button Padding="12,5" Margin="0,0,0,6" HorizontalContentAlignment="Left" Command="{Binding ObnovitIndexyCommand}"
                                    Content="Obnoviť indexy" ToolTip="Keď je vyhľadávanie pomalé alebo nepresné." />
                            <Button Padding="12,5" Margin="0,0,0,6" HorizontalContentAlignment="Left" Command="{Binding ZmensitCommand}"
                                    Content="Kompaktovať (zmenšiť)" ToolTip="Uvoľní nepoužité miesto a zmenší súbor – po veľkom mazaní alebo importe." />
                            <Button Padding="12,5" Margin="0,0,0,6" HorizontalContentAlignment="Left" Command="{Binding OtvoritDataCommand}"
                                    Content="Otvoriť priečinok databázy" />

                            <TextBlock Text="Oprava" Style="{StaticResource Stitok}" Margin="0,10,0,4" />
                            <Button Padding="12,5" Margin="0,0,0,6" HorizontalContentAlignment="Left" Command="{Binding OpravitVazbyCommand}"
                                    Content="Opraviť väzby…" ToolTip="Zmaže záznamy bez predmetu, predmety bez oblasti presunie do oblasti „Nezaradené predmety“." />
                            <Button Padding="12,5" Margin="0,0,0,6" HorizontalContentAlignment="Left" Command="{Binding ZachranitCommand}"
                                    Content="Záchrana dát…" ToolTip="Pri poškodení prenesie čitateľné dáta do novej databázy." />
                            <TextBlock Style="{StaticResource Popis}" FontSize="11.5" TextWrapping="Wrap"
                                       Text="Pri poškodenej databáze je najlepšia obnova zo zálohy. Záchrana dát je posledná možnosť, keď dobrá záloha nie je." />
                        </StackPanel>

                        <DockPanel Grid.Column="2">
                            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding TabulkyDatabazy}" Focusable="False" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Pocet}" FontWeight="SemiBold" />
                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Popis, Mode=OneWay}" /><Run Text="{Binding Nazov, StringFormat={}  ({0}), Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Uložiť protokol…" Padding="10,3" Command="{Binding UlozitProtokolCommand}" />
                                    <Button Content="Vymazať" Padding="10,3" Margin="6,0,0,0" Command="{Binding VymazatProtokolCommand}" />
                                </StackPanel>
                                <TextBlock Text="Protokol" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBox Text="{Binding Protokol, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5" MinHeight="260"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AcceptsReturn="True" />
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- testovacia sada -->
                <Border Grid.ColumnSpan="3" Style="{StaticResource Karta}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE9D5;" FontSize="20" Margin="0,0,10,0" />
                            <TextBlock Text="Testovacia sada a nový začiatok" Style="{StaticResource Podnadpis}" Margin="0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Text="Testovacia sada obsahuje ukážkové osnovy všetkých predmetov gymnázia a vymyslenú školu na vyskúšanie programu. Keď začnete pracovať s vlastnou školou, vymažte ju – nezostanú po nej žiadne zvyšky. Pred vymazaním sa vždy vytvorí záloha." />
                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Momentálne pracujete s testovacou sadou."
                                   Visibility="{Binding JeTestovaciaSada, Converter={StaticResource BoolNaViditelnost}}" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Nahrať testovaciu sadu…" Padding="12,5" Margin="0,0,8,6" Command="{Binding NahratTestovaciuSaduCommand}" />
                            <Button Padding="12,5" Margin="0,0,8,6" Command="{Binding VymazatUdajeCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Ikona}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Vymazať údaje…" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
