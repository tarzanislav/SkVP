<UserControl x:Class="SkVP.Views.PoznamkyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:SkVP.Views">
    <DockPanel Margin="44,30,44,24">
        <!-- hlavička -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{DynamicResource AccentButtonStyle}" Padding="14,6" Command="{Binding NovaPoznamkaCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Ikona}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Nová poznámka" />
                    </StackPanel>
                </Button>
                <Button Padding="12,6" Margin="8,0,0,0" Command="{Binding UlozitPdfCommand}" ToolTip="Zobrazený zoznam do PDF">
                    <TextBlock Text="PDF…" />
                </Button>
                <Button Padding="12,6" Margin="6,0,0,0" Command="{Binding TlacitCommand}" ToolTip="Vytlačiť zobrazený zoznam">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Ikona}" Text="&#xE749;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Tlačiť…" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Poznámky" Style="{StaticResource Nadpis}" Margin="0" />
                <TextBlock Text="{Binding Suhrn}" Style="{StaticResource Popis}" FontSize="14" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- filter a hľadanie -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Týka sa:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13.5" />
            <ComboBox ItemsSource="{Binding Filtre, Mode=OneTime}" SelectedItem="{Binding FilterObjektu}" Width="300" Margin="0,0,16,0" />
            <Grid>
                <TextBox Text="{Binding Hladat, UpdateSourceTrigger=PropertyChanged, Delay=250}" Padding="30,5,8,5" VerticalContentAlignment="Center" />
                <TextBlock Style="{StaticResource Ikona}" Text="&#xE721;" FontSize="13" Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Hľadať v poznámkach (aj bez diakritiky)" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding Hladat, Converter={StaticResource NieJePrazdne}, ConverterParameter=opacne}" />
            </Grid>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="480" />
            </Grid.ColumnDefinitions>

            <!-- nástenka lístkov -->
            <Grid>
                <TextBlock Text="{Binding TextPrazdneho}" Style="{StaticResource Popis}" FontSize="14" Margin="4,8"
                           Visibility="{Binding Zoznam.Count, Converter={StaticResource NulaNaViditelnost}}" />
                <ListBox ItemsSource="{Binding Zoznam}" SelectedItem="{Binding Vybrana}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,12,12" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Ram" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Ram" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Ram" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="236" MinHeight="130" CornerRadius="10" Padding="14,10,10,10" Background="{Binding Farba}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top">
                                        <Button x:Name="Pripnut" DockPanel.Dock="Right" Style="{StaticResource IkonoveTlacidlo}" Width="26" Height="26" FontSize="12"
                                                Content="&#xE718;" Foreground="{StaticResource AtramentStetec}" Opacity="0.35" ToolTip="Pripnúť / odopnúť"
                                                Command="{Binding DataContext.PrepnutPripnutieCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Nazov}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="44"
                                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource AtramentStetec}" />
                                    </DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ZmeneneText}" FontSize="11.5" Margin="0,6,0,0" Foreground="#5B616B" />
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Podrobnosti}" FontSize="12" Margin="0,6,0,0" Foreground="#3F4650"
                                               TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding MaPodrobnosti, Converter={StaticResource BoolNaViditelnost}}" />
                                    <TextBlock Text="{Binding Nahlad}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxHeight="72" Foreground="#2B3038" />
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Pripnuta}" Value="True">
                                    <Setter TargetName="Pripnut" Property="Opacity" Value="1" />
                                    <Setter TargetName="Pripnut" Property="Content" Value="&#xE840;" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- úprava vybranej poznámky -->
            <Border Grid.Column="2" Style="{StaticResource Karta}" Padding="18,16">
                <Grid>
                    <TextBlock Text="Vyberte poznámku na nástenke alebo vytvorte novú. Poznámky sa ukladajú automaticky."
                               Style="{StaticResource Popis}" FontSize="14"
                               Visibility="{Binding JeEditor, Converter={StaticResource InverzBoolNaViditelnost}}" />
                    <DockPanel Visibility="{Binding JeEditor, Converter={StaticResource BoolNaViditelnost}}">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Editor.Titulok}" Style="{StaticResource Podnadpis}" TextTrimming="CharacterEllipsis" />
                        <v:PoznamkaEditor x:Name="Editor" DataContext="{Binding Editor}" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
