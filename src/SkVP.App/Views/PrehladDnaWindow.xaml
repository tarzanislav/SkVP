<Window x:Class="SkVP.Views.PrehladDnaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prehľad dňa" Width="560" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="24,20,24,18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Otvoriť kalendár" Padding="14,5" Click="Kalendar_Click" />
            <Button Content="Otvoriť úlohy" Padding="14,5" Margin="8,0,0,0" Click="Ulohy_Click" />
            <Button Content="Zavrieť" MinWidth="100" Margin="8,0,0,0" IsCancel="True" IsDefault="True" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Nadpis" Style="{StaticResource Podnadpis}" FontSize="20" />
            <TextBlock Style="{StaticResource Popis}" Margin="0,0,0,8"
                       Text="Prehľad pri spustení programu vypnete v Nastaveniach (Kalendár a úlohy)." />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Obsah" />
        </ScrollViewer>
    </DockPanel>
</Window>
