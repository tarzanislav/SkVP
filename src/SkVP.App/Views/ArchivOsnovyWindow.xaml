<Window x:Class="SkVP.Views.ArchivOsnovyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archív osnovy" Width="820" Height="560" MinWidth="620" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="24,18,24,16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Nadpis" Style="{StaticResource Podnadpis}" FontSize="20" />
            <TextBlock x:Name="Aktualna" Style="{StaticResource Popis}" TextWrapping="Wrap" Margin="0,0,0,12" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Zavrieť" Padding="16,6" IsCancel="True" Margin="8,0,0,0" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="Otvorit" Padding="12,6" Click="Otvorit_Click" ToolTip="Otvorí archivovanú osnovu vo Worde (len na čítanie – kópia)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Ikona}" Text="&#xE8E5;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Otvoriť" />
                    </StackPanel>
                </Button>
                <Button x:Name="UlozitAko" Padding="12,6" Margin="8,0,0,0" Click="UlozitAko_Click" Content="Uložiť ako…" />
                <Button x:Name="Obnovit" Padding="12,6" Margin="8,0,0,0" Click="Obnovit_Click"
                        ToolTip="Archivovaná osnova sa stane aktuálnou – terajšia sa pritom zarchivuje." Content="Obnoviť túto verziu" />
            </StackPanel>
        </DockPanel>
        <ListBox x:Name="Zoznam" SelectionChanged="Zoznam_SelectionChanged" BorderThickness="1"
                 BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,4">
                        <TextBlock Text="{Binding Nazov}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Popis}" Style="{StaticResource Popis}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
