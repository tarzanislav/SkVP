<Window x:Class="SkVP.Views.PoznamkaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:SkVP.Views"
        Title="{Binding Titulok}" Width="620" Height="720" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="22,18,22,18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Zavrieť" MinWidth="110" IsCancel="True" IsDefault="False" Click="Zavriet_Click" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Titulok}" Style="{StaticResource Podnadpis}" TextTrimming="CharacterEllipsis" />
        <v:PoznamkaEditor x:Name="Editor" />
    </DockPanel>
</Window>
