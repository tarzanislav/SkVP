<Window x:Class="SkVP.Views.UvodnaStranaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:SkVP.Views"
        Title="Úvodná strana a hlavička" Width="820" Height="900" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- riadok úvodnej strany: zapnúť/vypnúť a text -->
        <Style x:Key="Prepinac" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="ToolTip" Value="Zobraziť na úvodnej strane" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="28,22,28,22">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Úvodná strana a hlavička strán" Style="{StaticResource Podnadpis}" FontSize="20" />
            <TextBlock Style="{StaticResource Popis}" FontSize="13" Margin="0,0,0,8"
                       Text="Každý riadok úvodnej strany môžete prepísať alebo vypnúť zaškrtávacím políčkom. Hlavičku ďalších strán nastavíte nižšie." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button DockPanel.Dock="Left" Content="Predvolené texty" Padding="12,5" Click="Predvolene_Click"
                    ToolTip="Vráti nadpis, podnadpis, platnosť, vlastné riadky, text dole a hlavičku na predvolené (logo zostane)" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Uložiť" MinWidth="120" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Click="Ulozit_Click" />
                <Button Content="Zrušiť" MinWidth="100" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="ÚVODNÁ STRANA" FontWeight="SemiBold" FontSize="11.5" Margin="0,4,0,0"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />

                <TextBlock Text="Logo školy" Style="{StaticResource Stitok}" />
                <DockPanel>
                    <CheckBox x:Name="LogoZobrazit" Style="{StaticResource Prepinac}" VerticalAlignment="Top" Margin="0,22,6,0"
                              ToolTip="Zobraziť logo na úvodnej strane" />
                    <Border Width="112" Height="70" CornerRadius="6" BorderThickness="1" Padding="6"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="White">
                        <Grid>
                            <Image x:Name="Logo" Stretch="Uniform" />
                            <TextBlock x:Name="BezLoga" Text="bez loga" Foreground="#6B7280" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Vybrať logo…" Padding="12,4" Click="VybratLogo_Click" />
                            <Button x:Name="OdstranitLogo" Content="Odstrániť" Padding="12,4" Margin="6,0,0,0" Click="OdstranitLogo_Click" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Popis}" Margin="0,6,0,0"
                                   Text="Obrázok PNG, JPEG, BMP alebo GIF. Rovnaké logo sa použije aj v hlavičke strán a v Nastaveniach." />
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="Názov školy" Style="{StaticResource Stitok}" />
                <DockPanel>
                    <CheckBox x:Name="SkolaZobrazit" Style="{StaticResource Prepinac}" />
                    <TextBox x:Name="Skola" TextChanged="Hlavicka_Zmena" />
                </DockPanel>

                <TextBlock Text="Adresa" Style="{StaticResource Stitok}" />
                <DockPanel>
                    <CheckBox x:Name="AdresaZobrazit" Style="{StaticResource Prepinac}" />
                    <TextBox x:Name="Adresa" />
                </DockPanel>

                <TextBlock Text="Nadpis" Style="{StaticResource Stitok}" />
                <DockPanel>
                    <CheckBox x:Name="NadpisZobrazit" Style="{StaticResource Prepinac}" />
                    <TextBox x:Name="Nadpis" TextChanged="Nadpis_Zmena" />
                </DockPanel>

                <TextBlock Text="Podnadpis" Style="{StaticResource Stitok}" />
                <DockPanel>
                    <CheckBox x:Name="PodnadpisZobrazit" Style="{StaticResource Prepinac}" />
                    <TextBox x:Name="Podnadpis" TextChanged="Nadpis_Zmena" />
                </DockPanel>

                <TextBlock Text="Druh školy a stupeň vzdelania" Style="{StaticResource Stitok}" />
                <DockPanel>
                    <CheckBox x:Name="TypZobrazit" Style="{StaticResource Prepinac}" />
                    <TextBox x:Name="Typ" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="30,4,0,0">
                    <TextBlock Style="{StaticResource Popis}" VerticalAlignment="Center"
                               Text="Namiesto staršieho „ISCED 3A“ sa dnes používa „úplné stredné všeobecné vzdelanie (ISCED 344)“." />
                    <Button Content="Použiť" Padding="10,2" Margin="8,0,0,0" Click="AktualnyStupen_Click" />
                </StackPanel>

                <TextBlock Text="Platnosť" Style="{StaticResource Stitok}" />
                <DockPanel>
                    <CheckBox x:Name="PlatnostZobrazit" Style="{StaticResource Prepinac}" />
                    <TextBox x:Name="Platnost" />
                </DockPanel>

                <TextBlock Text="Ďalšie riadky (napr. Schválené pedagogickou radou dňa …) – každý riadok zvlášť" Style="{StaticResource Stitok}" />
                <TextBox x:Name="VlastneRiadky" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Margin="30,0,0,0"
                         VerticalScrollBarVisibility="Auto" />

                <CheckBox x:Name="OblastiZobrazit" Content="Zoznam vzdelávacích oblastí s počtom predmetov" Margin="0,16,0,0" />

                <TextBlock Text="Text dole na strane" Style="{StaticResource Stitok}" />
                <CheckBox x:Name="PataZobrazit" Content="Zobraziť text dole na strane" />
                <TextBlock Style="{StaticResource Popis}" Margin="0,4,0,4"
                           Text="Napíšte ľubovoľný text – aj s formátovaním, odrážkami alebo tabuľkou (napr. prerokovanie v pedagogickej rade a podpisy). {datum} sa nahradí dátumom vytvorenia zostavy, {rok} rokom." />
                <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" CornerRadius="6" Height="300"
                        IsEnabled="{Binding IsChecked, ElementName=PataZobrazit}">
                    <v:EditorDokumentu x:Name="Pata" Kompaktny="True" JeUprava="True" Farba="#6B7280" />
                </Border>

                <!-- hlavička ďalších strán -->
                <TextBlock Text="HLAVIČKA ĎALŠÍCH STRÁN" FontWeight="SemiBold" FontSize="11.5" Margin="0,28,0,0"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Style="{StaticResource Popis}" Margin="0,4,0,0"
                           Text="Na všetkých stranách okrem úvodnej: vľavo text, vpravo názov školy a logo. Každú časť môžete vypnúť zvlášť alebo celú hlavičku naraz." />
                <CheckBox x:Name="HlavickaZobrazit" Content="Zobraziť hlavičku na ďalších stranách" FontWeight="SemiBold" Margin="0,10,0,0"
                          Checked="Hlavicka_Zmena" Unchecked="Hlavicka_Zmena" />

                <StackPanel Margin="28,0,0,0" IsEnabled="{Binding IsChecked, ElementName=HlavickaZobrazit}">
                    <TextBlock Text="Vľavo – text hlavičky" Style="{StaticResource Stitok}" />
                    <DockPanel>
                        <CheckBox x:Name="TextHlavickyZobrazit" Style="{StaticResource Prepinac}" ToolTip="Zobraziť text v hlavičke"
                                  Checked="Hlavicka_Zmena" Unchecked="Hlavicka_Zmena" />
                        <Button DockPanel.Dock="Right" Content="Podľa nadpisu" Padding="10,2" Margin="8,0,0,0" Click="TextHlavickyPodlaNadpisu_Click"
                                ToolTip="Nadpis – podnadpis z úvodnej strany (Školský vzdelávací program – Učebné osnovy)" />
                        <TextBox x:Name="TextHlavicky" TextChanged="Hlavicka_Zmena" />
                    </DockPanel>

                    <TextBlock Text="Vpravo" Style="{StaticResource Stitok}" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="SkolaVHlavickeZobrazit" Content="Názov školy" Checked="Hlavicka_Zmena" Unchecked="Hlavicka_Zmena" />
                        <CheckBox x:Name="LogoVHlavickeZobrazit" Content="Logo školy" Margin="16,0,0,0" Checked="Hlavicka_Zmena" Unchecked="Hlavicka_Zmena" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Ukážka hlavičky" Style="{StaticResource Stitok}" Margin="0,16,0,4" />
                <Border Background="White" CornerRadius="4" Padding="22,12,22,10" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <Grid>
                        <Border x:Name="UkazkaHlavicky" BorderBrush="#CBD2D9" BorderThickness="0,0,0,1" Padding="0,0,0,4" MinHeight="26">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="UkazkaSkola" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center" />
                                    <Image x:Name="UkazkaLogo" Height="26" MaxWidth="114" Stretch="Uniform" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="UkazkaText" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="UkazkaBezHlavicky" Text="Hlavička je vypnutá – strany budú bez hlavičky." Foreground="#6B7280"
                                   FontSize="11" FontStyle="Italic" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
