<Window x:Class="SkVP.Views.ArchivnaOsnovaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:SkVP.Views"
        Title="Archivovaná osnova" Width="980" Height="760" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="28,18,28,14" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Border.Background>
                <SolidColorBrush x:Name="Pozadie" Color="Transparent" />
            </Border.Background>
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Odznak}" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Ikona}" Text="&#xE72E;" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="len na čítanie" FontSize="12" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock x:Name="Rok" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="Nadpis" Style="{StaticResource Podnadpis}" FontSize="21" Margin="0,2,0,2" TextWrapping="Wrap" />
                    <TextBlock x:Name="Popis" Style="{StaticResource Popis}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel DockPanel.Dock="Bottom" Margin="28,10,28,14">
            <Button DockPanel.Dock="Right" Content="Zavrieť" Padding="16,6" IsCancel="True" Margin="8,0,0,0" />
            <StackPanel Orientation="Horizontal">
                <Button Padding="12,6" Click="Otvorit_Click" ToolTip="Otvorí kópiu archivovanej osnovy vo Worde (len na čítanie)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Ikona}" Text="&#xE8E5;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Otvoriť vo Worde (kópia)" />
                    </StackPanel>
                </Button>
                <Button Padding="12,6" Margin="8,0,0,0" Click="UlozitAko_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Ikona}" Text="&#xE74E;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Uložiť ako…" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
        <v:EditorDokumentu x:Name="Editor" JeUprava="False" Margin="12,0,12,0"
                           TextPrazdneho="Archivovaná osnova nemá text." />
    </DockPanel>
</Window>
