<UserControl x:Class="SkVP.Views.OblastView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SkVP.ViewModels"
             xmlns:m="clr-namespace:SkVP.Models"
             xmlns:v="clr-namespace:SkVP.Views">
    <UserControl.Resources>
        <!-- prepínač záložiek stránky -->
        <Style x:Key="Zalozka" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,26,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Background="Transparent">
                            <ContentPresenter Margin="0,6,0,8" />
                            <Border x:Name="Ciara" Height="3" CornerRadius="1.5" Background="Transparent" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Ciara" Property="Background"
                                        Value="{Binding Oblast.Farba, Converter={StaticResource FarbaNaStetec}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StavOsnovy" TargetType="Border" BasedOn="{StaticResource Odznak}">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Stav}" Value="{x:Static m:StavOsnovy.Prazdna}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Stav}" Value="{x:Static m:StavOsnovy.NaKontrolu}">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Stav}" Value="{x:Static m:StavOsnovy.Hotova}">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- hlavička oblasti -->
        <Border DockPanel.Dock="Top" Padding="44,26,44,0"
                Background="{Binding Oblast.Farba, Converter={StaticResource FarbaNaStetec}, ConverterParameter=12}">
            <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Style="{StaticResource RiadokTlacidlo}" Padding="6,2" Margin="-6,0,0,0" Command="{Binding Hlavny.OtvorOsnovyCommand}">
                        <TextBlock Text="Osnovy" Style="{StaticResource Popis}" FontSize="13" />
                    </Button>
                    <TextBlock Text="&#xE76C;" Style="{StaticResource Ikona}" FontSize="10" Margin="4,0" Opacity="0.6" />
                    <TextBlock Text="{Binding Oblast.NazovDruhu}" Style="{StaticResource Popis}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>

                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
                        <Button Padding="14,6" Command="{Binding Hlavny.OtvorTlacCommand}" CommandParameter="{Binding Oblast}"
                                ToolTip="Spojiť osnovy tejto oblasti do jedného dokumentu – tlač, PDF, Word">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Ikona}" Text="&#xE749;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding TextTlace}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border DockPanel.Dock="Left" Width="6" CornerRadius="3" Margin="0,4,16,4"
                            Background="{Binding Oblast.Farba, Converter={StaticResource FarbaNaStetec}}" />
                    <StackPanel>
                        <TextBox Style="{StaticResource NadpisovePole}" Text="{Binding Nazov, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Kliknite a premenujte oblasť" KeyDown="Nazov_KeyDown"
                                 IsReadOnly="{Binding Oblast.JeCastiOsnov, Mode=OneWay}" />
                        <TextBlock Text="{Binding Oblast.Charakteristika}" Style="{StaticResource Popis}" FontSize="14.5" Margin="0,2,0,0"
                                   Visibility="{Binding Oblast.JeCastiOsnov, Converter={StaticResource BoolNaViditelnost}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Oblast.PocetText}" Style="{StaticResource Popis}" FontSize="13.5" />
                            <TextBlock Text="  •  " Style="{StaticResource Popis}" FontSize="13.5" />
                            <TextBlock Text="{Binding Oblast.HotoveText}" Style="{StaticResource Popis}" FontSize="13.5" />
                            <ItemsControl ItemsSource="{Binding Paleta}" Margin="22,0,0,0" VerticalAlignment="Center" Focusable="False"
                                          ToolTip="Farba oblasti v programe a v dokumentoch"
                                          Visibility="{Binding JeOblast, Converter={StaticResource BoolNaViditelnost}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="16" Height="16" Margin="0,0,5,0" Cursor="Hand"
                                                Command="{Binding DataContext.NastavFarbuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Ellipse x:Name="Kruh" Fill="{Binding Converter={StaticResource FarbaNaStetec}}" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Kruh" Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <Setter TargetName="Kruh" Property="StrokeThickness" Value="2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <Border Height="16" Visibility="{Binding JeOblast, Converter={StaticResource InverzBoolNaViditelnost}}" />
                <StackPanel Orientation="Horizontal" Margin="22,20,0,0" Visibility="{Binding JeOblast, Converter={StaticResource BoolNaViditelnost}}">
                    <RadioButton Style="{StaticResource Zalozka}" Content="Predmety" x:Name="ZalozkaPredmety" IsChecked="True"
                                 GroupName="ZalozkyOblasti" Checked="Zalozka_Checked" />
                    <RadioButton Style="{StaticResource Zalozka}" Content="Charakteristika oblasti" x:Name="ZalozkaCharakteristika"
                                 GroupName="ZalozkyOblasti" Checked="Zalozka_Checked" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid>
            <!-- zoznam predmetov -->
            <ScrollViewer x:Name="PanelPredmety" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="44,18,44,40" MaxWidth="1100">
                    <ItemsControl x:Name="ZoznamPredmetov" ItemsSource="{Binding Oblast.Predmety}" Focusable="False" AllowDrop="True"
                                  DragOver="Zoznam_DragOver" Drop="Zoznam_Drop">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PredmetVM}">
                                <Grid x:Name="Riadok" Tag="{Binding}" Background="Transparent" AllowDrop="True"
                                      PreviewMouseLeftButtonDown="Riadok_MouseDown" MouseMove="Riadok_MouseMove">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.RowSpan="2" Height="1" VerticalAlignment="Bottom" Margin="78,0,0,0" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                    <Button x:Name="Otvorit" Style="{StaticResource RiadokTlacidlo}" Padding="10,13,190,13"
                                            Command="{Binding DataContext.Hlavny.OtvorPredmetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Otvoriť dokument">
                                        <DockPanel>
                                            <TextBlock x:Name="Uchytka" DockPanel.Dock="Left" Text="&#xE76F;" Style="{StaticResource Ikona}" FontSize="12"
                                                       Margin="0,0,10,0" Opacity="0" Cursor="SizeAll" ToolTip="Potiahnite a presuňte predmet" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Cislo}" Width="46" FontFamily="{StaticResource PismoNadpisov}"
                                                       FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{Binding Oblast.Farba, Converter={StaticResource FarbaNaStetec}, ConverterParameter=T}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding Premenuva, Converter={StaticResource InverzBoolNaViditelnost}}">
                                                    <TextBlock Text="{Binding Nazov}" FontSize="16" TextTrimming="CharacterEllipsis" MaxWidth="560" />
                                                    <!-- oprava názvu priamo v riadku -->
                                                    <Button x:Name="Pero" Style="{StaticResource IkonoveTlacidlo}" Content="&#xE70F;" FontSize="12"
                                                            Margin="6,-4,0,-4" Opacity="0.35" Cursor="Hand"
                                                            ToolTip="Opraviť názov (F2) – zmení sa aj v textoch osnov"
                                                            Command="{Binding DataContext.ZacniPremenovanieCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border Style="{StaticResource StavOsnovy}">
                                                        <TextBlock Text="{Binding StavText}" FontSize="11.5" />
                                                    </Border>
                                                    <TextBlock Text="{Binding UpraveneText}" Style="{StaticResource Popis}" FontSize="11.5"
                                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                                </StackPanel>
                                                <!-- údaje z úvodnej tabuľky osnovy: profilácie vľavo, platnosť vpravo -->
                                                <DockPanel Margin="0,5,0,0" Visibility="{Binding MaUdajeOsnovy, Converter={StaticResource BoolNaViditelnost}}">
                                                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding UpravaUdajov}" MinWidth="0" Margin="14,-4,0,-4"
                                                              VerticalAlignment="Center" ToolTip="Opraviť profilácie a platnosť – zapíšu sa aj do dokumentu osnovy">
                                                        <TextBlock Text="opraviť údaje" FontSize="11.5" Style="{StaticResource Popis}" />
                                                    </CheckBox>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TextPlatnosti}" FontSize="12" Margin="16,0,0,0"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TextProfilacii}" FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>

                                    <!-- premenovanie priamo v zozname -->
                                    <TextBox x:Name="PolePremenovania" Margin="88,8,200,0" VerticalAlignment="Top" FontSize="15"
                                             Text="{Binding NovyNazov, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding Premenuva, Converter={StaticResource BoolNaViditelnost}}"
                                             KeyDown="Premenovanie_KeyDown" LostKeyboardFocus="Premenovanie_LostFocus"
                                             IsVisibleChanged="Premenovanie_IsVisibleChanged" />

                                    <StackPanel x:Name="Akcie" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Margin="0,0,10,0" Opacity="0">
                                        <Button Style="{StaticResource IkonoveTlacidlo}" Content="&#xE70E;" ToolTip="Posunúť vyššie (Alt+↑)"
                                                Command="{Binding DataContext.Hlavny.PosunPredmetHoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding JePrvy, Converter={StaticResource InverzBool}}" />
                                        <Button Style="{StaticResource IkonoveTlacidlo}" Content="&#xE70D;" ToolTip="Posunúť nižšie (Alt+↓)"
                                                Command="{Binding DataContext.Hlavny.PosunPredmetDoleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" IsEnabled="{Binding JePosledny, Converter={StaticResource InverzBool}}" />
                                        <Button Style="{StaticResource IkonoveTlacidlo}" Content="&#xE70F;" ToolTip="Opraviť názov (F2)"
                                                Command="{Binding DataContext.ZacniPremenovanieCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource IkonoveTlacidlo}" Content="&#xE74D;" ToolTip="Odstrániť"
                                                Command="{Binding DataContext.Hlavny.OdstranPredmetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="&#xE76C;" Style="{StaticResource Ikona}" FontSize="12" Margin="10,0,4,0" Opacity="0.6" />
                                    </StackPanel>

                                    <!-- oprava profilácií a platnosti (zapíše sa do úvodnej tabuľky osnovy) -->
                                    <Border Grid.Row="1" Margin="88,0,10,12" Padding="12,10" CornerRadius="6"
                                            Background="{DynamicResource LayerFillColorDefaultBrush}" BorderThickness="1"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            Visibility="{Binding UpravaUdajov, Converter={StaticResource BoolNaViditelnost}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Profilácie" Style="{StaticResource Popis}" FontSize="12" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding UpravaProfilacii, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Platnosť" Style="{StaticResource Popis}" FontSize="12" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding UpravaPlatnosti, UpdateSourceTrigger=PropertyChanged}" ToolTip="napr. od 1.9.2026" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                                                <Button Content="Uložiť do osnovy" Padding="12,4" Style="{DynamicResource AccentButtonStyle}"
                                                        Command="{Binding DataContext.UlozitUdajeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Zrušiť" Padding="12,4" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.ZrusitUpravuUdajovCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Riadok" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Akcie" Property="Opacity" Value="1" />
                                        <Setter TargetName="Uchytka" Property="Opacity" Value="0.55" />
                                        <Setter TargetName="Pero" Property="Opacity" Value="1" />
                                    </Trigger>
                                    <Trigger SourceName="Riadok" Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="Akcie" Property="Opacity" Value="1" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding TextPrazdnej}"
                               Style="{StaticResource Popis}" FontSize="14" Margin="10,10,0,10"
                               Visibility="{Binding Oblast.Pocet, Converter={StaticResource NulaNaViditelnost}}" />

                    <!-- nový predmet -->
                    <DockPanel Margin="10,16,10,0">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE710;" Style="{StaticResource Ikona}" Width="46" FontSize="18"
                                   Foreground="{Binding Oblast.Farba, Converter={StaticResource FarbaNaStetec}, ConverterParameter=T}" />
                        <Button DockPanel.Dock="Right" Content="{Binding TextPridat}" Margin="10,0,0,0" Padding="16,6"
                                Style="{DynamicResource AccentButtonStyle}" Command="{Binding PridajPredmetCommand}" />
                        <Grid>
                            <TextBox x:Name="NovyPredmet" Text="{Binding NovyPredmet, UpdateSourceTrigger=PropertyChanged}" KeyDown="NovyPredmet_KeyDown"
                                     FontSize="14" />
                            <TextBlock Text="{Binding PopisNoveho}" IsHitTestVisible="False"
                                       Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding NovyPredmet, Converter={StaticResource NieJePrazdne}, ConverterParameter=opacne}" />
                        </Grid>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Popis}" Margin="66,10,0,0" Text="{Binding TextPomoci}" />
                </StackPanel>
            </ScrollViewer>

            <!-- charakteristika vzdelávacej oblasti -->
            <DockPanel x:Name="PanelCharakteristika" Visibility="Collapsed">
                <Border DockPanel.Dock="Top" Margin="44,8,24,0" Padding="14,8" CornerRadius="8"
                        Background="{Binding Oblast.Farba, Converter={StaticResource FarbaNaStetec}, ConverterParameter=18}"
                        Visibility="{Binding MaCharakteristikuSvp, Converter={StaticResource BoolNaViditelnost}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Padding="12,4" Command="{Binding CharakteristikaZoSvpCommand}"
                                ToolTip="Nahradí text oficiálnym znením zo Štátneho vzdelávacieho programu pre gymnáziá (doterajší sa zarchivuje)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Ikona}" Text="&#xE8A5;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Prevziať zo ŠVP…" />
                            </StackPanel>
                        </Button>
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5">
                            <Run Text="Štátny vzdelávací program pre gymnáziá obsahuje charakteristiku tejto oblasti." />
                            <Run FontWeight="SemiBold">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Text" Value="" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CharakteristikaJeZoSvp}" Value="True">
                                                <Setter Property="Text" Value="Text je zhodný so ŠVP." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                        </TextBlock>
                    </DockPanel>
                </Border>
                <v:ListaDokumentu DockPanel.Dock="Top" DataContext="{Binding Dokument}"
                                  Popis="Úvodný text oblasti – v zostave sa vytlačí pred predmetmi oblasti." />
                <v:EditorDokumentu x:Name="Editor" JeUprava="{Binding Dokument.JeUprava, Mode=OneWay}" Farba="{Binding Oblast.Farba}"
                                   TextPrazdneho="Charakteristika oblasti zatiaľ nie je napísaná. Zapnite úpravu a napíšte ju alebo ju vložte z Wordu." />
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
