<UserControl x:Class="SkVP.Views.PredmetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SkVP.ViewModels"
             xmlns:v="clr-namespace:SkVP.Views">
    <DockPanel>
        <!-- hlavička predmetu -->
        <Border DockPanel.Dock="Top" Padding="44,22,44,4">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Style="{StaticResource RiadokTlacidlo}" Padding="6,2" Margin="-6,0,0,0" Command="{Binding Hlavny.OtvorOsnovyCommand}">
                        <TextBlock Text="Osnovy" Style="{StaticResource Popis}" FontSize="13" />
                    </Button>
                    <TextBlock Text="&#xE76C;" Style="{StaticResource Ikona}" FontSize="10" Margin="4,0" Opacity="0.6" />
                    <Button Style="{StaticResource RiadokTlacidlo}" Padding="6,2" Command="{Binding Hlavny.OtvorOblastCommand}" CommandParameter="{Binding Oblast}">
                        <TextBlock Text="{Binding Oblast.Nazov}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{Binding Oblast.Farba, Converter={StaticResource FarbaNaStetec}, ConverterParameter=T}" />
                    </Button>
                </StackPanel>

                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="6" CornerRadius="3" Margin="0,4,16,4"
                            Background="{Binding Oblast.Farba, Converter={StaticResource FarbaNaStetec}}" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Predmet.Cislo}" FontFamily="{StaticResource PismoNadpisov}" FontSize="30"
                               FontWeight="SemiBold" Margin="0,0,14,0" VerticalAlignment="Top"
                               Foreground="{Binding Oblast.Farba, Converter={StaticResource FarbaNaStetec}, ConverterParameter=T}" />
                    <TextBox Style="{StaticResource NadpisovePole}" Text="{Binding Nazov, UpdateSourceTrigger=LostFocus}"
                             ToolTip="Kliknite a premenujte predmet" KeyDown="Nazov_KeyDown" />
                </DockPanel>

                <DockPanel Margin="22,8,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding Stavy, Mode=OneTime}" SelectedItem="{Binding VybranyStav}" DisplayMemberPath="Nazov"
                                  MinWidth="170" ToolTip="Stav spracovania osnovy" Margin="0,0,10,0" />
                        <Button Style="{StaticResource IkonoveTlacidlo}" Content="&#xE76B;" ToolTip="Predchádzajúci predmet"
                                Command="{Binding OtvorPredchadzajuciCommand}" />
                        <Button Style="{StaticResource IkonoveTlacidlo}" Content="&#xE76C;" ToolTip="Ďalší predmet"
                                Command="{Binding OtvorDalsiCommand}" />
                        <ToggleButton Margin="8,0,0,0" Padding="10,5" IsChecked="{Binding ZobrazitPlanovanie}" ToolTip="Úlohy, termíny v kalendári a poznámky k tejto osnove">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Ikona}" Text="&#xE9D5;" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Úlohy " />
                                <TextBlock Text="{Binding PanelPlanovania.Pocet}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Margin="8,0,0,0" Padding="10,5" IsChecked="{Binding ZobrazitSuvislosti}" ToolTip="Súvislosti s inými predmetmi a oblasťami">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Ikona}" Text="&#xE71B;" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Súvislosti " />
                                <TextBlock Text="{Binding Suvislosti.Count}" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <WrapPanel>
                            <TextBlock Text="{Binding Predmet.StavText}" Style="{StaticResource Popis}" FontSize="13" />
                            <TextBlock Text="  •  upravené " Style="{StaticResource Popis}" FontSize="13"
                                       Visibility="{Binding Predmet.UpraveneText, Converter={StaticResource NieJePrazdne}}" />
                            <TextBlock Text="{Binding Predmet.UpraveneText}" Style="{StaticResource Popis}" FontSize="13" />
                        </WrapPanel>
                        <WrapPanel Margin="0,2,0,0" Visibility="{Binding Predmet.MaUdajeOsnovy, Converter={StaticResource BoolNaViditelnost}}">
                            <TextBlock Text="{Binding Predmet.TextProfilacii}" FontSize="12.5" Margin="0,0,18,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding Predmet.TextPlatnosti}" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding PoznamkaOsnovy}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{Binding Oblast.Farba, Converter={StaticResource FarbaNaStetec}, ConverterParameter=T}"
                                   Visibility="{Binding PoznamkaOsnovy, Converter={StaticResource NieJePrazdne}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Padding="10,3" Command="{Binding ImportovatOsnovuCommand}"
                                    ToolTip="Nová osnova z Wordu alebo PDF – doterajšia sa zarchivuje s rokom archivácie">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Ikona}" Text="&#xE8B5;" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding TextImportu}" FontSize="12.5" />
                                </StackPanel>
                            </Button>
                            <Button Padding="10,3" Margin="6,0,0,0" Command="{Binding ArchivCommand}"
                                    ToolTip="Staršie verzie osnovy – otvoriť, uložiť alebo obnoviť">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Ikona}" Text="&#xE7B8;" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock FontSize="12.5"><Run Text="Archív (" /><Run Text="{Binding PocetArchivovanych, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <v:ListaDokumentu DockPanel.Dock="Top" DataContext="{Binding Dokument}"
                          Popis="Na čítanie. Zmeny sa ukladajú automaticky a predchádzajúca verzia sa archivuje." />

        <!-- úlohy, termíny a poznámky -->
        <Border DockPanel.Dock="Right" Width="320" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                Visibility="{Binding ZobrazitPlanovanie, Converter={StaticResource BoolNaViditelnost}}">
            <v:PanelPlanovania DataContext="{Binding PanelPlanovania}" />
        </Border>

        <!-- súvislosti -->
        <Border DockPanel.Dock="Right" Width="300" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                Visibility="{Binding ZobrazitSuvislosti, Converter={StaticResource BoolNaViditelnost}}">
            <DockPanel Margin="18,16,14,16">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Súvislosti" Style="{StaticResource Podnadpis}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Popis}" Margin="0,0,0,12"
                               Text="Prepojte predmet s inými predmetmi alebo oblasťami – nadväznosť, predpoklady, medzipredmetové vzťahy." />
                    <Button HorizontalAlignment="Left" Padding="12,5" Command="{Binding PridatSuvislostCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Prepojiť…" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <ItemsControl ItemsSource="{Binding Suvislosti}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SuvislostVM}">
                                <Grid x:Name="Riadok" Margin="0,0,0,4">
                                    <Button Style="{StaticResource RiadokTlacidlo}" Padding="8,7,34,7"
                                            Command="{Binding DataContext.OtvoritSuvislostCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="0,2,10,2"
                                                    Background="{Binding Farba, Converter={StaticResource FarbaNaStetec}}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Popis}" Style="{StaticResource Popis}" FontSize="11.5" />
                                                <TextBlock Text="{Binding Nazov}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Nadradeny}" Style="{StaticResource Popis}" FontSize="11.5" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                    <Button x:Name="Zrusit" Style="{StaticResource IkonoveTlacidlo}" Content="&#xE711;" FontSize="10"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,2,0" Width="26" Height="26"
                                            ToolTip="Zrušiť prepojenie" Visibility="Hidden"
                                            Command="{Binding DataContext.OdstranitSuvislostCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Riadok" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Zrusit" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <v:EditorDokumentu x:Name="Editor" JeUprava="{Binding Dokument.JeUprava, Mode=OneWay}" Farba="{Binding Oblast.Farba}"
                           TextPrazdneho="Osnova zatiaľ nemá text. Kliknite na Upraviť vo Worde alebo Úprava – pripravia sa nadpisy častí osnovy (charakteristika, ciele, obsahový a výkonový štandard …)." />
    </DockPanel>
</UserControl>
