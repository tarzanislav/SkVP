<UserControl x:Class="SkVP.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SkVP.ViewModels"
             xmlns:m="clr-namespace:SkVP.Models">
    <UserControl.Resources>
        <!-- jeden predmet ako dlaždica v stene osnov: plná = hotová, tónovaná = rozpracovaná, obrys = nezačatá -->
        <Style x:Key="Dlazdica" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="{Binding Oblast.Farba, Converter={StaticResource FarbaNaStetec}, ConverterParameter=55}" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Stav}" Value="{x:Static m:StavOsnovy.Rozpracovana}">
                    <Setter Property="Background" Value="{Binding Oblast.Farba, Converter={StaticResource FarbaNaStetec}, ConverterParameter=40}" />
                    <Setter Property="BorderBrush" Value="{Binding Oblast.Farba, Converter={StaticResource FarbaNaStetec}, ConverterParameter=88}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Stav}" Value="{x:Static m:StavOsnovy.NaKontrolu}">
                    <Setter Property="Background" Value="{Binding Oblast.Farba, Converter={StaticResource FarbaNaStetec}, ConverterParameter=88}" />
                    <Setter Property="BorderBrush" Value="{Binding Oblast.Farba, Converter={StaticResource FarbaNaStetec}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Stav}" Value="{x:Static m:StavOsnovy.Hotova}">
                    <Setter Property="Background" Value="{Binding Oblast.Farba, Converter={StaticResource FarbaNaStetec}}" />
                    <Setter Property="BorderBrush" Value="{Binding Oblast.Farba, Converter={StaticResource FarbaNaStetec}}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.12" ScaleY="1.12" />
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BieleTlacidlo" TargetType="Button" BasedOn="{StaticResource IkonoveTlacidlo}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44,34,44,40" MaxWidth="1180">
            <TextBlock Text="{Binding Datum}" Style="{StaticResource Popis}" FontSize="13.5" />
            <TextBlock Style="{StaticResource Nadpis}" Margin="0,2,0,4">
                <Run Text="{Binding Pozdrav, Mode=OneWay}" /><Run Text=", tu je stav učebných osnov" />
            </TextBlock>
            <TextBlock Text="{Binding Zhrnutie}" Style="{StaticResource Popis}" FontSize="14" Margin="0,0,0,22" />

            <!-- horné panely: dnes (dátum, meniny, sviatky), počasie, výrok dňa -->
            <UniformGrid Rows="1" Margin="0,0,0,18" Visibility="{Binding MaHornePanely, Converter={StaticResource BoolNaViditelnost}}">
                <!-- dnes -->
                <Border CornerRadius="12" Padding="20,16" Margin="0,0,9,0" Visibility="{Binding UkazDnes, Converter={StaticResource BoolNaViditelnost}}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4F46E5" Offset="0" />
                            <GradientStop Color="#7C3AED" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="{Binding DenVTyzdni}" Foreground="White" Opacity="0.85" FontSize="13" />
                        <TextBlock Text="{Binding DatumVelky}" Foreground="White" FontFamily="{StaticResource PismoNadpisov}" FontSize="24"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TyzdenText}" Foreground="White" Opacity="0.8" FontSize="12" Margin="0,1,0,10" />

                        <TextBlock Text="Meniny" Foreground="White" Opacity="0.8" FontSize="12" />
                        <TextBlock Text="{Binding MeninyDnes}" Foreground="White" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Foreground="White" Opacity="0.85" FontSize="12" TextWrapping="Wrap">
                            <Run Text="Zajtra:" /> <Run Text="{Binding MeninyZajtra, Mode=OneWay}" />
                        </TextBlock>

                        <Border CornerRadius="6" Padding="8,3" Margin="0,10,0,0" HorizontalAlignment="Left" Background="#33FFFFFF"
                                Visibility="{Binding JeDnesVolno, Converter={StaticResource BoolNaViditelnost}}">
                            <TextBlock Text="Dnes je deň pracovného pokoja" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Sviatky}" Margin="0,8,0,0" Focusable="False"
                                      Visibility="{Binding MaSviatky, Converter={StaticResource BoolNaViditelnost}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,1">
                                        <TextBlock DockPanel.Dock="Left" Text="★" Foreground="#FDE68A" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding}" Foreground="White" TextWrapping="Wrap" FontSize="12.5" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding NajblizsiVolnyDen}" Foreground="White" Opacity="0.85" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding NajblizsiVolnyDen, Converter={StaticResource NieJePrazdne}}" />

                        <Border Height="1" Background="#40FFFFFF" Margin="0,12,0,10" />
                        <TextBlock Text="{Binding StavSkolskehoRoka}" Foreground="White" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Visibility="{Binding StavSkolskehoRoka, Converter={StaticResource NieJePrazdne}}" />
                        <Button Padding="0" Margin="0,4,0,0" HorizontalAlignment="Left" Cursor="Hand" Command="{Binding OtvorNovinkyCommand}"
                                ToolTip="Otvoriť sekciu Novinky – termínovník" Visibility="{Binding NajblizsiTermin, Converter={StaticResource NieJePrazdne}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Pozadie" CornerRadius="8" Padding="10,6" Background="#26FFFFFF">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pozadie" Property="Background" Value="#40FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <TextBlock Text="Najbližší termín (Novinky)" Foreground="White" Opacity="0.8" FontSize="11.5" />
                                <TextBlock Text="{Binding NajblizsiTermin}" Foreground="White" FontSize="12.5" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- počasie -->
                <Border CornerRadius="12" Padding="20,16" Margin="9,0,9,0" Visibility="{Binding UkazPocasie, Converter={StaticResource BoolNaViditelnost}}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0EA5E9" Offset="0" />
                            <GradientStop Color="#2563EB" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource BieleTlacidlo}" Content="&#xE72C;" ToolTip="Obnoviť počasie" Command="{Binding ObnovitPocasieCommand}"
                                        Visibility="{Binding JeMiestoPocasia, Converter={StaticResource BoolNaViditelnost}}" />
                                <Button Style="{StaticResource BieleTlacidlo}" Content="&#xE707;" ToolTip="Zmeniť mesto alebo obec" Command="{Binding ZmenitMiestoCommand}" />
                            </StackPanel>
                            <TextBlock Text="Počasie" Foreground="White" Opacity="0.85" FontSize="13" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- výber miesta -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0" Visibility="{Binding UpravaMiesta, Converter={StaticResource BoolNaViditelnost}}">
                            <TextBlock Text="Mesto alebo obec:" Foreground="White" FontSize="12.5" />
                            <DockPanel Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Content="Hľadať" Padding="12,4" Margin="6,0,0,0" IsDefault="{Binding UpravaMiesta}"
                                        Command="{Binding HladatMiestoCommand}" />
                                <TextBox Text="{Binding HladaneMiesto, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding NajdeneMiesta}" Margin="0,6,0,0" Focusable="False" MaxHeight="150">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="8,4" Margin="0,0,0,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Command="{Binding DataContext.VybratMiestoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding Popis}" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Zrušiť" HorizontalAlignment="Left" Padding="12,3" Margin="0,4,0,0" Command="{Binding ZrusitUpravuMiestaCommand}" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Top" Visibility="{Binding JePocasie, Converter={StaticResource BoolNaViditelnost}}">
                            <TextBlock Text="{Binding Pocasie.Miesto.Nazov}" Foreground="White" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Pocasie.Miesto.Popis}" />
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Pocasie.Symbol}" FontSize="44" Margin="0,0,14,0" VerticalAlignment="Center"
                                           Foreground="White" FontFamily="Segoe UI Emoji, Segoe UI Symbol" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Pocasie.TeplotaText}" Foreground="White" FontSize="32" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Pocasie.Popis}" Foreground="White" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding Pocasie.Podrobnosti}" Foreground="White" Opacity="0.85" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <Border CornerRadius="8" Background="#26FFFFFF" Padding="4,8" Margin="0,12,0,0">
                                <ItemsControl ItemsSource="{Binding Pocasie.Dni}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center" ToolTip="{Binding Popis}">
                                                <TextBlock Text="{Binding Den}" FontSize="11.5" HorizontalAlignment="Center" Foreground="White" Opacity="0.85" />
                                                <TextBlock Text="{Binding Symbol}" FontSize="20" HorizontalAlignment="Center" Foreground="White"
                                                           FontFamily="Segoe UI Emoji, Segoe UI Symbol" />
                                                <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="White">
                                                    <Run Text="{Binding MaxText, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="{Binding MinText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding ZrazkyText}" FontSize="10.5" HorizontalAlignment="Center" Foreground="#BAE6FD" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Text="{Binding Pocasie.Aktualizovane}" Foreground="White" Opacity="0.75" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Text="{Binding PocasieStav}" Foreground="White" Opacity="0.9" FontSize="12.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding PocasieStav, Converter={StaticResource NieJePrazdne}}" />
                    </DockPanel>
                </Border>

                <!-- výrok dňa -->
                <Border CornerRadius="12" Padding="20,16" Margin="9,0,0,0" Visibility="{Binding UkazCitat, Converter={StaticResource BoolNaViditelnost}}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E11D48" Offset="0" />
                            <GradientStop Color="#C2410C" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource BieleTlacidlo}" Content="&#xE72A;" ToolTip="Ďalší výrok" Command="{Binding DalsiCitatCommand}" />
                                <Button Style="{StaticResource BieleTlacidlo}" Content="&#xED1A;" ToolTip="Tento výrok už nezobrazovať" Command="{Binding SkrytCitatCommand}" />
                            </StackPanel>
                            <TextBlock Text="Výrok dňa" Foreground="White" Opacity="0.85" FontSize="13" VerticalAlignment="Center" />
                        </DockPanel>
                        <Button DockPanel.Dock="Bottom" Padding="0" HorizontalAlignment="Left" Cursor="Hand" Margin="0,10,0,0"
                                Command="{Binding OtvoritZdrojCitatovCommand}" ToolTip="Otvoriť citaty-slavnych.sk">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="{Binding CitatyZdroj}" Foreground="White" Opacity="0.75" FontSize="11" TextWrapping="Wrap" />
                        </Button>
                        <StackPanel>
                            <TextBlock Text="“" Foreground="White" Opacity="0.35" FontSize="56" FontFamily="Georgia" Height="44" Margin="0,-6,0,-10" />
                            <TextBlock Text="{Binding CitatText}" Foreground="White" FontSize="17" FontWeight="SemiBold" LineHeight="25" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CitatAutor}" Foreground="White" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CitatPopis}" Foreground="White" Opacity="0.8" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{Binding CitatPopis, Converter={StaticResource NieJePrazdne}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <!-- stena osnov: každý predmet jedna dlaždica vo farbe svojej oblasti -->
            <Border Style="{StaticResource Karta}" Padding="24,20,18,14">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Oblasti}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OblastVM}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource RiadokTlacidlo}" Padding="8,4" Margin="-8,0,12,6" VerticalAlignment="Top"
                                            Command="{Binding DataContext.Hlavny.OtvorOblastCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nazov}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{Binding Farba, Converter={StaticResource FarbaNaStetec}}" />
                                            <TextBlock Text="{Binding HotoveText}" Style="{StaticResource Popis}" FontSize="11.5" />
                                        </StackPanel>
                                    </Button>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Predmety}" Focusable="False" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PredmetVM}">
                                                <Border Style="{StaticResource Dlazdica}" MouseLeftButtonUp="Dlazdica_Click" Tag="{Binding}">
                                                    <Border.ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Nazov}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding StavText}" />
                                                        </StackPanel>
                                                    </Border.ToolTip>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Width="14" Height="14" CornerRadius="3.5" Background="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="hotová" Style="{StaticResource Popis}" Margin="6,0,18,0" VerticalAlignment="Center" />
                        <Border Width="14" Height="14" CornerRadius="3.5" Background="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.55" />
                        <TextBlock Text="na kontrolu" Style="{StaticResource Popis}" Margin="6,0,18,0" VerticalAlignment="Center" />
                        <Border Width="14" Height="14" CornerRadius="3.5" Background="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.25" />
                        <TextBlock Text="rozpracovaná" Style="{StaticResource Popis}" Margin="6,0,18,0" VerticalAlignment="Center" />
                        <Border Width="14" Height="14" CornerRadius="3.5" BorderThickness="1.5" BorderBrush="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="nezačatá" Style="{StaticResource Popis}" Margin="6,0,18,0" VerticalAlignment="Center" />
                        <TextBlock Text="Kliknutím na dlaždicu otvoríte osnovu predmetu." Style="{StaticResource Popis}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Karta}">
                    <StackPanel>
                        <TextBlock Text="Pokrok podľa oblastí" Style="{StaticResource Podnadpis}" />
                        <ItemsControl ItemsSource="{Binding Oblasti}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OblastVM}">
                                    <StackPanel Margin="0,4,0,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Popis}">
                                                <Run Text="{Binding PocetHotovych, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Pocet, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Nazov}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <ProgressBar Height="6" Margin="0,5,0,0" Minimum="0" Maximum="1" Value="{Binding Podiel, Mode=OneWay}"
                                                     Foreground="{Binding Farba, Converter={StaticResource FarbaNaStetec}}"
                                                     Background="{Binding Farba, Converter={StaticResource FarbaNaStetec}, ConverterParameter=22}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Karta}">
                    <StackPanel>
                        <TextBlock Text="Naposledy upravené" Style="{StaticResource Podnadpis}" />
                        <TextBlock Text="Zatiaľ ste neupravili žiadnu osnovu. Otvorte predmet v sekcii Osnovy a zapnite úpravu."
                                   Style="{StaticResource Popis}" FontSize="13"
                                   Visibility="{Binding NicNebolo, Converter={StaticResource BoolNaViditelnost}}" />
                        <ItemsControl ItemsSource="{Binding Naposledy}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PredmetVM}">
                                    <Button Style="{StaticResource RiadokTlacidlo}" Padding="8,7" Margin="-8,0"
                                            Command="{Binding DataContext.Hlavny.OtvorPredmetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Margin="0,0,12,0"
                                                    Background="{Binding Oblast.Farba, Converter={StaticResource FarbaNaStetec}}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding UpraveneText}" Style="{StaticResource Popis}"
                                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Nazov}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding StavText}" Style="{StaticResource Popis}" FontSize="11.5" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Otvoriť osnovy" Style="{DynamicResource AccentButtonStyle}" Padding="16,6"
                                    Command="{Binding Hlavny.OtvorOsnovyCommand}" />
                            <Button Content="Zostaviť dokument na tlač" Padding="16,6" Margin="8,0,0,0"
                                    Command="{Binding Hlavny.OtvorTlacCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <WrapPanel Margin="0,18,0,0">
                <TextBlock Text="Zobraziť na dashboarde:" Style="{StaticResource Popis}" FontSize="12.5" Margin="0,0,14,0" VerticalAlignment="Center" />
                <CheckBox Content="Dátum, meniny a sviatky" IsChecked="{Binding UkazDnes}" Margin="0,0,16,0" />
                <CheckBox Content="Počasie" IsChecked="{Binding UkazPocasie}" Margin="0,0,16,0" />
                <CheckBox Content="Výrok dňa" IsChecked="{Binding UkazCitat}" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
