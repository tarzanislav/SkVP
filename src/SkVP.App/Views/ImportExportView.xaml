<UserControl x:Class="SkVP.Views.ImportExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44,34,44,40" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="Import a export" Style="{StaticResource Nadpis}" />
            <TextBlock Text="{Binding Suhrn}" Style="{StaticResource Popis}" FontSize="14" Margin="0,4,0,20" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- export osnov -->
                <Border Style="{StaticResource Karta}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xEDE1;" FontSize="20" Margin="0,0,10,0" />
                            <TextBlock Text="Export osnov" Style="{StaticResource Podnadpis}" Margin="0" />
                        </StackPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                            <Button Padding="16,7" Margin="0,0,8,6" Style="{DynamicResource AccentButtonStyle}"
                                    Command="{Binding ExportovatOsnovyCommand}" Content="Exportovať osnovy…" />
                            <Button Padding="12,7" Margin="0,0,0,6" Command="{Binding NastaveniaPdfCommand}" Content="Nastavenia PDF…"
                                    ToolTip="Šifrovanie, heslo, zákazy, odtiene sivej, zosvetlenie, 2 – 8 strán na list a brožúra pre export do PDF" />
                        </WrapPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Text="Všetky osnovy, vybrané oblasti alebo jednotlivé predmety – ako jeden dokument alebo každý predmet zvlášť („05 Fyzika 2026“). Formáty Word, PDF, PDF/A-2b, PDF/A-3b, PDF/X-4, JPEG, PNG a TIFF, s úvodnou stranou, obsahom a ďalšími voľbami ako pri tlači." />
                    </DockPanel>
                </Border>

                <!-- import osnov -->
                <Border Grid.Column="2" Style="{StaticResource Karta}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE8B5;" FontSize="20" Margin="0,0,10,0" />
                            <TextBlock Text="Import osnov" Style="{StaticResource Podnadpis}" Margin="0" />
                        </StackPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                            <Button Padding="16,7" Margin="0,0,8,6" Style="{DynamicResource AccentButtonStyle}"
                                    Command="{Binding ImportovatOsnovyCommand}" Content="Importovať osnovy z Wordu alebo PDF…" />
                            <Button Padding="12,7" Margin="0,0,8,6" Command="{Binding ImportovatZPriecinkaCommand}" Content="Z priečinka…"
                                    ToolTip="Všetky osnovy (Word a PDF) z vybraného priečinka naraz – súbory sa len čítajú" />
                            <Button Padding="12,7" Margin="0,0,0,6" Command="{Binding OtvoritPriecinokOsnovCommand}" Content="Priečinok Osnovy"
                                    ToolTip="{Binding PriecinokOsnov}" />
                        </WrapPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Text="Nové osnovy pre zmenené alebo novo pridané predmety – jednotlivo alebo celý priečinok. Program rozpozná predmet podľa názvu súboru (aj skratky SJL, ANJ, KAJ …) alebo textu, pri cudzích jazykoch sa opýta na úroveň (B1, B2), PDF prevedie na Word bez Wordu. Doterajšia osnova sa najprv zarchivuje so záznamom a rokom archivácie („05 Fyzika – archív 2026“), nová dostane rok zmeny („05 Fyzika 2026“). Zdrojové súbory sa nemenia." />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- oblasti a predmety -->
            <Border Style="{StaticResource Karta}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Ikona}" Text="&#xE8FD;" FontSize="20" Margin="0,0,10,0" />
                        <TextBlock Text="Vzdelávacie oblasti a predmety" Style="{StaticResource Podnadpis}" Margin="0" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Import zo súboru (Excel, Word, PDF, HTML, XML, JSON, text), z webovej stránky alebo diktovaním – program sám vyhľadá oblasti a predmety (tabuľka, nadpisy, zoznamy) a doplní ich alebo nahradí doterajšie. Pred zmenou sa urobí záloha." />
                    <TextBlock Text="Import" Style="{StaticResource Stitok}" Margin="0,0,0,6" />
                    <WrapPanel>
                        <Button Padding="14,7" Margin="0,0,8,6" Command="{Binding ImportovatStrukturuCommand}"
                                ToolTip="Excel, Word, PDF, HTML, XML, JSON alebo text">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Ikona}" Text="&#xE8B5;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Zo súboru…" />
                            </StackPanel>
                        </Button>
                        <Button Padding="14,7" Margin="0,0,8,6" Command="{Binding ImportovatZWebuCommand}"
                                ToolTip="Webová stránka (napr. učebný plán na webe školy) alebo súbor na internete">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Ikona}" Text="&#xE774;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Z webovej stránky…" />
                            </StackPanel>
                        </Button>
                        <Button Padding="14,7" Margin="0,0,8,6" Command="{Binding DiktovatStrukturuCommand}"
                                ToolTip="Hlasové písanie Windows – „Človek a príroda: fyzika, chémia, biológia.“">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Ikona}" Text="&#xE720;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Diktovať…" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="Export" Style="{StaticResource Stitok}" Margin="0,8,0,6" />
                    <WrapPanel>
                        <Button Padding="12,7" Margin="0,0,8,6" Command="{Binding ExportovatStrukturuCommand}" CommandParameter="xlsx" Content="Excel…" />
                        <Button Padding="12,7" Margin="0,0,8,6" Command="{Binding ExportovatStrukturuCommand}" CommandParameter="docx" Content="Word…" />
                        <Button Padding="12,7" Margin="0,0,8,6" Command="{Binding ExportovatStrukturuCommand}" CommandParameter="pdf" Content="PDF, obrázky…"
                                ToolTip="PDF, PDF/A-2b, PDF/A-3b, PDF/X-4, JPEG, PNG, TIFF" />
                        <Button Padding="12,7" Margin="0,0,8,6" Command="{Binding ExportovatStrukturuCommand}" CommandParameter="html" Content="HTML…" />
                        <Button Padding="12,7" Margin="0,0,8,6" Command="{Binding ExportovatStrukturuCommand}" CommandParameter="xml" Content="XML…" />
                        <Button Padding="12,7" Margin="0,0,8,6" Command="{Binding ExportovatStrukturuCommand}" CommandParameter="json" Content="JSON…" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
