<UserControl x:Class="SkVP.Views.ListaDokumentu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Koren">
    <StackPanel>
        <Border Padding="44,10,44,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding StavUlozenia}" Style="{StaticResource Popis}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Padding="14,6" Margin="0,0,8,0" Command="{Binding UpravitVoWordeCommand}"
                            Style="{DynamicResource AccentButtonStyle}"
                            Visibility="{Binding MozeWord, Converter={StaticResource BoolNaViditelnost}}"
                            ToolTip="Otvorí dokument vo Worde. Po uložení vo Worde sa zmeny prevezmú do programu.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE8A5;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Upraviť vo Worde" />
                        </StackPanel>
                    </Button>
                    <ToggleButton Padding="14,6" IsChecked="{Binding JeUprava, Mode=OneWay}" Command="{Binding PrepniUpravuCommand}"
                                  ToolTip="Upraviť text priamo v programe (ukladá sa automaticky)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE70F;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock x:Name="TextUpravy" Text="Úprava" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
                <TextBlock Text="{Binding Popis, ElementName=Koren}" Style="{StaticResource Popis}" FontSize="13" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </DockPanel>
        </Border>

        <!-- dokument je otvorený vo Worde -->
        <Border Padding="44,9" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                Visibility="{Binding JeVoWorde, Converter={StaticResource BoolNaViditelnost}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Prevziať zmeny teraz" Padding="12,4" Command="{Binding PrevziatZWorduCommand}" />
                <TextBlock Style="{StaticResource Ikona}" Text="&#xE8A5;" Margin="0,0,10,0" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                           Text="Dokument je otvorený vo Worde. Keď ho vo Worde uložíte, zmeny sa tu zobrazia samé. Po zatvorení Wordu sa úprava ukončí." />
            </DockPanel>
        </Border>

        <!-- dokument obsahuje prvky, ktoré vstavaný editor nezobrazí -->
        <Border Padding="44,8" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                Visibility="{Binding VarovaniaText, Converter={StaticResource NieJePrazdne}}">
            <DockPanel>
                <TextBlock Style="{StaticResource Ikona}" Text="&#xE7BA;" Margin="0,0,10,0" />
                <TextBlock Text="{Binding VarovaniaText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
