<UserControl x:Class="SkVP.Views.UdajeOrganizacieEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- údaje o organizácii: DataContext = UdajeOrganizacieVM -->
    <StackPanel>
        <TextBlock Text="Názov školy" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
        <TextBox x:Name="Nazov" Text="{Binding Nazov, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Názov organizačnej zložky (nepovinné – pri spojenej škole)" Style="{StaticResource Stitok}" />
        <TextBox Text="{Binding Zlozka, UpdateSourceTrigger=PropertyChanged}" ToolTip="Napr. Gymnázium ako organizačná zložka Spojenej školy" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Ulica a číslo" Style="{StaticResource Stitok}" />
                <TextBox Text="{Binding Ulica, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="PSČ" Style="{StaticResource Stitok}" />
                <TextBox Text="{Binding Psc, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding ChybaPsc}" Foreground="#C92A2A" FontSize="11.5" TextWrapping="Wrap"
                           Visibility="{Binding MaChybuPsc, Converter={StaticResource BoolNaViditelnost}}" />
            </StackPanel>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Mesto, obec" Style="{StaticResource Stitok}" />
                <TextBox Text="{Binding Mesto, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Štát" Style="{StaticResource Stitok}" />
                <ComboBox IsEditable="True" ItemsSource="{Binding Staty}" Text="{Binding Stat, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="IČO" Style="{StaticResource Stitok}" />
                <TextBox Text="{Binding Ico, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding ChybaIco}" Foreground="#C92A2A" FontSize="11.5"
                           Visibility="{Binding MaChybuIco, Converter={StaticResource BoolNaViditelnost}}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="DIČ" Style="{StaticResource Stitok}" />
                <TextBox Text="{Binding Dic, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding ChybaDic}" Foreground="#C92A2A" FontSize="11.5"
                           Visibility="{Binding MaChybuDic, Converter={StaticResource BoolNaViditelnost}}" />
            </StackPanel>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="E-mail" Style="{StaticResource Stitok}" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding ChybaEmail}" Foreground="#C92A2A" FontSize="11.5"
                           Visibility="{Binding MaChybuEmail, Converter={StaticResource BoolNaViditelnost}}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Telefón" Style="{StaticResource Stitok}" />
                <TextBox Text="{Binding Telefon, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
