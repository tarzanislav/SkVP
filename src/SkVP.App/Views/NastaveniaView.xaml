<UserControl x:Class="SkVP.Views.NastaveniaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44,34,44,40" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="Nastavenia" Style="{StaticResource Nadpis}" />
            <TextBlock Style="{StaticResource Popis}" FontSize="14" Margin="0,4,0,22" Text="Zmeny sa ukladajú hneď." />

            <!-- škola -->
            <Border Style="{StaticResource Karta}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Škola" Style="{StaticResource Podnadpis}" />
                        <TextBlock Text="Názov školy" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Skola}" />
                        <TextBlock Text="Adresa" Style="{StaticResource Stitok}" />
                        <TextBox Text="{Binding Adresa}" />
                        <TextBlock Style="{StaticResource Popis}" Margin="0,8,0,0"
                                   Text="Názov a logo školy sa tlačia na úvodnej strane zostáv a v hlavičke strán." />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Logo školy" Style="{StaticResource Stitok}" Margin="0,34,0,4" />
                        <Border Height="110" CornerRadius="8" BorderThickness="1" Padding="10"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="White">
                            <Grid>
                                <Image Source="{Binding Logo}" Stretch="Uniform" />
                                <TextBlock Text="Bez loga" Foreground="#8A94A3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding MaLogo, Converter={StaticResource InverzBoolNaViditelnost}}" />
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Vybrať…" Padding="12,4" Command="{Binding VybratLogoCommand}" />
                            <Button Content="Odstrániť" Padding="12,4" Margin="6,0,0,0" Command="{Binding OdstranitLogoCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- program -->
            <Border Style="{StaticResource Karta}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Školský vzdelávací program" Style="{StaticResource Podnadpis}" />
                    <TextBlock Text="Názov programu" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NazovProgramu}" />
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Druh školy a stupeň vzdelania" Style="{StaticResource Stitok}" />
                            <TextBox Text="{Binding Typ}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Platnosť (napr. od 1. 9. 2026)" Style="{StaticResource Stitok}" />
                            <TextBox Text="{Binding Obdobie}" />
                        </StackPanel>
                    </Grid>
                    <DockPanel Margin="0,18,0,0">
                        <Button DockPanel.Dock="Right" Padding="14,6" Command="{Binding NacitatZExceluCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Ikona}" Text="&#xE8B5;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Načítať z Excelu…" />
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Vzdelávacie oblasti a predmety z tabuľky" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Popis}"
                                       Text="Tabuľka Excel: názov oblasti v stĺpci A, predmety pod ním v stĺpci B. Oblasti a predmety sa doplnia alebo nahradia." />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- úprava osnov -->
            <Border Style="{StaticResource Karta}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Úprava osnov" Style="{StaticResource Podnadpis}" />
                    <TextBlock Text="{Binding StavWordu}" Style="{StaticResource Popis}" FontSize="13" Margin="0,0,0,10" />
                    <RadioButton GroupName="Uprava" IsChecked="{Binding UpravaVoWorde}" IsEnabled="{Binding WordJeNainstalovany}">
                        <TextBlock TextWrapping="Wrap">Upravovať vo Worde, ak je nainštalovaný – zachová sa všetko formátovanie dokumentu</TextBlock>
                    </RadioButton>
                    <RadioButton GroupName="Uprava" IsChecked="{Binding UpravaVoWorde, Converter={StaticResource InverzBool}}" Margin="0,4,0,0">
                        <TextBlock TextWrapping="Wrap">Vždy vo vstavanom editore programu</TextBlock>
                    </RadioButton>
                    <TextBlock Style="{StaticResource Popis}" Margin="0,10,0,0"
                               Text="Vstavaný editor je k dispozícii vždy (tlačidlo Úprava). Pred každou úpravou sa doterajšia verzia osnovy zarchivuje." />
                </StackPanel>
            </Border>

            <!-- vzhľad -->
            <Border Style="{StaticResource Karta}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Vzhľad" Style="{StaticResource Podnadpis}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Podľa Windows" Margin="0,0,24,0" GroupName="Tema"
                                     IsChecked="{Binding Tema, Converter={StaticResource RovnaSa}, ConverterParameter=system}" />
                        <RadioButton Content="Svetlý" Margin="0,0,24,0" GroupName="Tema"
                                     IsChecked="{Binding Tema, Converter={StaticResource RovnaSa}, ConverterParameter=svetla}" />
                        <RadioButton Content="Tmavý" GroupName="Tema"
                                     IsChecked="{Binding Tema, Converter={StaticResource RovnaSa}, ConverterParameter=tmava}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- údaje a zálohy -->
            <Border Style="{StaticResource Karta}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Údaje a zálohy" Style="{StaticResource Podnadpis}" />
                    <TextBlock Style="{StaticResource Popis}" FontSize="13" TextWrapping="Wrap"
                               Text="Všetko – oblasti, predmety, osnovy aj ich staršie verzie – je v jednej databáze. Pri prvom spustení dňa sa automaticky zálohuje." />
                    <TextBlock Style="{StaticResource Stitok}" Text="Databáza" />
                    <TextBlock Text="{Binding PriecinokDat}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Stitok}" Text="Zálohy" />
                    <TextBlock Text="{Binding PriecinokZaloh}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PoslednaZaloha}" Style="{StaticResource Popis}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Zálohovať teraz" Style="{DynamicResource AccentButtonStyle}" Padding="14,6" Command="{Binding ZalohovatCommand}" />
                        <Button Content="Otvoriť priečinok záloh" Padding="14,6" Margin="8,0,0,0" Command="{Binding OtvoritZalohyCommand}" />
                        <Button Content="Otvoriť priečinok databázy" Padding="14,6" Margin="8,0,0,0" Command="{Binding OtvoritDataCommand}" />
                    </StackPanel>
                    <Separator Margin="0,18,0,14" />
                    <TextBlock Text="Testovacia sada a vymazanie údajov" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Popis}" Margin="0,2,0,10"
                               Text="Testovacia sada obsahuje ukážkové učebné osnovy všetkých predmetov gymnázia na vyskúšanie programu. Pred vymazaním údajov sa vždy vytvorí záloha." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Nahrať testovaciu sadu…" Padding="14,6" Command="{Binding NahratTestovaciuSaduCommand}" />
                        <Button Padding="14,6" Margin="8,0,0,0" Command="{Binding VymazatUdajeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Ikona}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Vymazať údaje…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- aktualizácie -->
            <Border Style="{StaticResource Karta}">
                <StackPanel>
                    <TextBlock Text="Aktualizácie" Style="{StaticResource Podnadpis}" />
                    <TextBlock Style="{StaticResource Popis}" FontSize="13">
                        <Run Text="Nainštalovaná verzia SkVP " /><Run Text="{Binding Verzia, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". Nové verzie sa sťahujú z GitHubu (tarzanislav/skvp)." />
                    </TextBlock>
                    <CheckBox Content="Kontrolovať novú verziu pri spustení programu" IsChecked="{Binding KontrolovatAktualizacie}" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Skontrolovať teraz" Padding="14,6" Command="{Binding SkontrolovatAktualizacieCommand}" />
                        <TextBlock Text="{Binding StavAktualizacie}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
