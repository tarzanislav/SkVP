<Window x:Class="SkVP.Views.JednotnyVzhladWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:SkVP.Views"
        Title="Jednotný vzhľad dokumentu" Width="1060" Height="800" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="28,18,28,14" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Border.Background>
                <SolidColorBrush x:Name="Pozadie" Color="Transparent" />
            </Border.Background>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                    <RadioButton x:Name="ZobrazitNovy" Content="Nový vzhľad" IsChecked="True" Style="{DynamicResource {x:Type ToggleButton}}"
                                 Padding="12,5" GroupName="Zobrazenie" Checked="Zobrazenie_Checked" />
                    <RadioButton x:Name="ZobrazitPovodny" Content="Pôvodný" Style="{DynamicResource {x:Type ToggleButton}}"
                                 Padding="12,5" Margin="6,0,0,0" GroupName="Zobrazenie" Checked="Zobrazenie_Checked" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Jednotný vzhľad dokumentu" FontWeight="SemiBold" FontSize="13" x:Name="Druh" />
                    <TextBlock x:Name="Nadpis" Style="{StaticResource Podnadpis}" FontSize="21" Margin="0,2,0,4" TextWrapping="Wrap" />
                    <TextBlock x:Name="Suhrn" Style="{StaticResource Popis}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- prvky, ktoré by sa stratili -->
        <Border x:Name="PanelStrat" DockPanel.Dock="Top" Padding="28,9" Visibility="Collapsed"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
            <DockPanel>
                <TextBlock Style="{StaticResource Ikona}" Text="&#xE7BA;" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock x:Name="Straty" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="28,10,28,14">
            <Button DockPanel.Dock="Right" Content="Zrušiť" Padding="16,6" IsCancel="True" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" x:Name="Pouzit" Padding="16,6" Style="{DynamicResource AccentButtonStyle}" Click="Pouzit_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Ikona}" Text="&#xE73E;" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Použiť jednotný vzhľad" />
                </StackPanel>
            </Button>
            <TextBlock Style="{StaticResource Popis}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                       Text="Pôvodná verzia sa uloží do archívu dokumentu – kedykoľvek ju obnovíte tlačidlom Archív pri osnove." />
        </DockPanel>

        <v:EditorDokumentu x:Name="Editor" JeUprava="False" Margin="12,0,12,0" TextPrazdneho="Dokument nemá text." />
    </DockPanel>
</Window>
