<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>SkVP</AssemblyName>
    <RootNamespace>SkVP</RootNamespace>
    <ApplicationIcon>Assets\skvp.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>SkVP</Product>
    <Company>tarzanislav</Company>
    <Description>SkVP – evidencia, spracovanie a archivácia školského vzdelávacieho programu</Description>
    <Copyright>© 2026 tarzanislav</Copyright>
    <SatelliteResourceLanguages>sk</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WPF0001;MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="PDFsharp-MigraDoc-WPF" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\skvp.ico" />
    <EmbeddedResource Include="Zdroje\ucebny_plan_gymnazium.json" LogicalName="SkVP.UcebnyPlanGymnazium.json" />
    <EmbeddedResource Include="Zdroje\testovacia_sada.json" LogicalName="SkVP.TestovaciaSada.json" />
  </ItemGroup>

</Project>
